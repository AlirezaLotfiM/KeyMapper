<UserControl x:Class="KeyMapper.FlexVolumeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="52"
             Height="150"
             MinWidth="40"
             MinHeight="110"
             Focusable="True"
             Cursor="Hand"
             AutomationProperties.Name="App volume"
             PreviewKeyDown="Root_PreviewKeyDown"
             PreviewMouseWheel="Root_PreviewMouseWheel"
             SizeChanged="Root_SizeChanged">
    <UserControl.Resources>
        <!-- Samsung Flex UI Solid Gradient Brush -->
        <LinearGradientBrush x:Key="SamsungFlexVolumeGradient" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#8B86A8" Offset="0.0"/>
            <GradientStop Color="#B8B4D4" Offset="0.35"/>
            <GradientStop Color="#E2DEF5" Offset="0.75"/>
            <GradientStop Color="#FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SamsungFlexFeatherGradient" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#E2DEF5" Offset="0.0"/>
            <GradientStop Color="#FFFFFF" Offset="0.6"/>
            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid x:Name="MainContainer">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ContainerScale" ScaleX="1" ScaleY="1" CenterX="26" CenterY="75"/>
        </Grid.RenderTransform>

        <!-- Outer Bloom (Disabled / Collapsed to remove all ambient shadows) -->
        <Border x:Name="OuterBloom"
                Margin="6"
                VerticalAlignment="Bottom"
                Background="{StaticResource SamsungFlexVolumeGradient}"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"/>

        <!-- Main Capsule Shell -->
        <Border x:Name="CapsuleShell"
                Margin="4"
                Background="#16161E"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                ClipToBounds="True"
                SnapsToDevicePixels="True"
                PreviewMouseLeftButtonDown="Capsule_PreviewMouseLeftButtonDown"
                PreviewMouseMove="Capsule_PreviewMouseMove"
                PreviewMouseLeftButtonUp="Capsule_PreviewMouseLeftButtonUp"
                LostMouseCapture="Capsule_LostMouseCapture">
            <Grid x:Name="CapsuleSurface" Background="Transparent">
                <Grid.Clip>
                    <RectangleGeometry x:Name="CapsuleClip"/>
                </Grid.Clip>
                <Border Background="#121218" Opacity="0.85"/>

                <!-- Core Solid Volume Fill (Top shadow and glow layers removed) -->
                <Canvas x:Name="LightingCanvas" ClipToBounds="True" IsHitTestVisible="False">
                    <Border x:Name="FillCore"
                            Background="{StaticResource SamsungFlexVolumeGradient}"/>
                    <Border x:Name="FillFeather"
                            Background="{StaticResource SamsungFlexFeatherGradient}"
                            Visibility="Collapsed"/>
                    <Border x:Name="BoundaryGlow"
                            Background="#FFFFFF"
                            Opacity="0"
                            Visibility="Collapsed"/>
                </Canvas>

                <!-- Subtle frosted texture effect -->
                <Rectangle Fill="#FFFFFF"
                           Opacity="0.04"
                           IsHitTestVisible="False">
                    <Rectangle.OpacityMask>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,5,5"
                                      ViewportUnits="Absolute"
                                      Viewbox="0,0,5,5"
                                      ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#DFFFFFFF" Geometry="M0.4,0.7 A0.45,0.45 0 1 1 1.3,0.7 A0.45,0.45 0 1 1 0.4,0.7"/>
                                    <GeometryDrawing Brush="#8FFFFFFF" Geometry="M3.1,2.6 A0.35,0.35 0 1 1 3.8,2.6 A0.35,0.35 0 1 1 3.1,2.6"/>
                                    <GeometryDrawing Brush="#AFFFFFFF" Geometry="M1.7,4.2 A0.3,0.3 0 1 1 2.3,4.2 A0.3,0.3 0 1 1 1.7,4.2"/>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>

                <Border BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        Opacity="0.15"
                        IsHitTestVisible="False"/>

                <!-- Samsung Flex UI 3 Dots at Top -->
                <StackPanel x:Name="MoreDots"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,14,0,0"
                            IsHitTestVisible="False">
                    <Ellipse Width="3.5" Height="3.5" Fill="#D0D0E0" Margin="1.5,0"/>
                    <Ellipse Width="3.5" Height="3.5" Fill="#D0D0E0" Margin="1.5,0"/>
                    <Ellipse Width="3.5" Height="3.5" Fill="#D0D0E0" Margin="1.5,0"/>
                </StackPanel>

                <!-- Samsung Flex UI Music Note Icon at Bottom -->
                <Grid Width="18"
                      Height="18"
                      Margin="0,0,0,13"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False">
                    <Path x:Name="MusicNotePath"
                          Data="M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4,4,4 4-1.79,4-4V7h4V3h-6z"
                          Fill="#FFFFFF"
                          Opacity="0.95"
                          Stretch="Uniform"/>
                    <Line x:Name="MuteSlash"
                          X1="2"
                          Y1="2"
                          X2="16"
                          Y2="16"
                          Stroke="#FF4D4D"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed"/>
                </Grid>

                <!-- Invisible native range surface keeps keyboard and automation behavior -->
                <Slider x:Name="NativeSlider"
                        Orientation="Vertical"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                        IsMoveToPointEnabled="True"
                        Opacity="0.01"
                        Focusable="False"
                        IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
