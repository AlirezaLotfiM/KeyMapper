<UserControl x:Class="KeyMapper.VpnControlView"
             x:Name="VpnRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KeyMapper"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Segoe UI"
             PreviewKeyDown="VpnControlView_PreviewKeyDown"
             Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <PathGeometry x:Key="PowerIconGeometry">M12,3A1,1 0 0,0 11,4V12A1,1 0 0,0 12,13A1,1 0 0,0 13,12V4A1,1 0 0,0 12,3M16.59,5.41A1,1 0 0,0 15.17,6.83C17.03,8.69 17.03,11.71 15.17,13.57C13.31,15.43 10.29,15.43 8.43,13.57C6.57,11.71 6.57,8.69 8.43,6.83A1,1 0 0,0 7.01,5.41C4.39,8.03 4.39,12.27 7.01,14.89C9.63,17.5 13.87,17.5 16.49,14.89C19.11,12.27 19.11,8.03 16.59,5.41Z</PathGeometry>
        <PathGeometry x:Key="SearchIconGeometry">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.29,20.41L13.03,15.15C12.03,15.69 10.8,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5A4.5,4.5 0 0,0 5,9.5A4.5,4.5 0 0,0 9.5,14A4.5,4.5 0 0,0 14,9.5A4.5,4.5 0 0,0 9.5,5Z</PathGeometry>
        <PathGeometry x:Key="TrashIconGeometry">M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z</PathGeometry>

        <!-- Sidebar Tab Button Style -->
        <Style x:Key="SidebarNavTab" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Happ Power Circle Style -->
        <Style x:Key="CircularPowerBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="{DynamicResource AppSurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Happ Mode Pill Button Style -->
        <Style x:Key="ModePillBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ultra-Slim Minimalist ScrollBar & ScrollViewer Style -->
        <Style x:Key="SlimScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{DynamicResource AppMutedTextBrush}" CornerRadius="2.5" Opacity="0.4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SlimScrollBar}" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" ViewportSize="{TemplateBinding ViewportHeight}" Margin="8,0,2,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main 3-Column Layout: [Left Sidebar] [Middle Server List] [Right Power Dashboard] -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Vertical Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="8,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Add Button -->
                    <Button Grid.Row="0" x:Name="SidebarAddBtn" Click="SidebarAddBtn_Click" Style="{DynamicResource SecondaryButton}" Height="36" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="➕ " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Add" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Navigation Menu Items -->
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavServersRadio" Content="🌐  Servers" IsChecked="True" Style="{DynamicResource SidebarNavTab}" Click="NavTab_Click"/>
                        <RadioButton x:Name="NavSettingsRadio" Content="⚙  Settings" Style="{DynamicResource SidebarNavTab}" Click="NavTab_Click"/>
                        <RadioButton x:Name="NavPerAppRadio" Content="🔀  Per-App" Style="{DynamicResource SidebarNavTab}" Click="NavTab_Click"/>
                        <RadioButton x:Name="NavLogsRadio" Content="📜  Logs" Style="{DynamicResource SidebarNavTab}" Click="NavTab_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 1: Main Content Area -->
            <Grid Grid.Column="1">
                <!-- 1. SERVERS VIEW TAB (Middle list + Right Hero Power Dashboard) -->
                <Grid x:Name="ServersMainView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Middle Column: Server List Panel -->
                    <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title -->
                            <TextBlock Grid.Row="0" Text="Servers" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,10"/>

                            <!-- Search Box & Quick Actions -->
                            <Border Grid.Row="1" Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Grid.Column="0" Background="Transparent" BorderThickness="0" TextChanged="SearchBox_TextChanged" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" ToolTip="Type here to search..."/>
                                    <Button Grid.Column="1" Click="PingAllBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Test Real Delay (All)" Margin="4,0">
                                        <TextBlock Text="⏱️" FontSize="14"/>
                                    </Button>
                                    <Button Grid.Column="2" Click="ClearOfflineBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Clear Offline">
                                        <TextBlock Text="⋮" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Grouped Server List (Slim Rows + Slim Spaced ScrollViewer) -->
                            <ScrollViewer x:Name="ServersScrollViewer" Grid.Row="2" Style="{StaticResource SlimScrollViewer}" Padding="0,0,10,0">
                                <ItemsControl x:Name="GroupedServersItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="True" Margin="0,0,0,12" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                <Expander.Header>
                                                    <Grid HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding GroupName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                                                            <!-- Group Ping Button -->
                                                            <Button Click="PingGroupBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Test Real Delay for this Group" Margin="0,0,4,0">
                                                                <TextBlock Text="⏱️" FontSize="12"/>
                                                            </Button>

                                                            <Button Click="RefreshGroupSubBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Refresh Subscription" Margin="0,0,4,0" Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVisConverter}}">
                                                                <TextBlock Text="🔄" FontSize="12"/>
                                                            </Button>
                                                            <Button Click="DeleteGroupSubBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Delete Subscription" Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVisConverter}}">
                                                                <TextBlock Text="🗑️" FontSize="12"/>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Sub Quota Bar & Clean Metadata Lines -->
                                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVisConverter}}">
                                                            <ProgressBar Value="{Binding Subscription.UsagePercentage, Mode=OneWay}" Maximum="100" Height="4" Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppSurfaceAltBrush}" BorderThickness="0" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding TrafficSummaryText}" FontSize="10" Foreground="{DynamicResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding DaysLeftText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Expander.Header>

                                                <!-- Inner Servers Slim Rows -->
                                                <ItemsControl ItemsSource="{Binding Servers}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="RowBorder" Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="ServerRow_Click">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Flag Image / Emoji -->
                                                                    <TextBlock Grid.Column="0" Text="{Binding Flag}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                    <!-- Title & Subtitle -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock x:Name="ActiveBadgeText" Text=" ● ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Visibility="Collapsed" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <TextBlock Text="{Binding ProtocolBadge}" FontSize="10" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="/" FontSize="10" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="{Binding Transport}" FontSize="10" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- Ping Display -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding PingDisplay}" FontSize="11" Foreground="#10B981" FontWeight="Bold"/>
                                                                    </StackPanel>

                                                                    <!-- Delete Server Button -->
                                                                    <Button Grid.Column="3" Click="DeleteServerBtn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" ToolTip="Delete Server" VerticalAlignment="Center">
                                                                        <Path Data="{StaticResource TrashIconGeometry}" Fill="#EF4444" Width="12" Height="12" Stretch="Uniform"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>

                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="2"/>
                                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                                                                    <Setter TargetName="ActiveBadgeText" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Right Column: Hero Power Dashboard (Happ VPN Clean Style) -->
                    <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                            
                            <!-- Happ VPN Glowing Power Circle -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,30">
                                <Ellipse Width="180" Height="180" Fill="{DynamicResource AppSurfaceBrush}" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="2"/>
                                <Ellipse Width="140" Height="140" Fill="{DynamicResource AppSurfaceAltBrush}"/>
                                
                                <Button x:Name="HeroPowerBtn" Click="ConnectBtn_Click" Width="100" Height="100" Style="{DynamicResource CircularPowerBtn}">
                                    <StackPanel VerticalAlignment="Center">
                                        <Path Data="{StaticResource PowerIconGeometry}" Fill="{DynamicResource AppAccentBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="HeroStatusText" Text="DISCONNECTED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="HeroDurationText" Text="00:00:00" FontSize="10" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Selected Server Flag & Name -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock x:Name="SelectedFlagText" Text="🌐" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SelectedServerNameText" Text="No Server Selected" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Action Button: Test Ping / Real Delay -->
                            <Button Click="PingAllBtn_Click" Width="200" Height="36" Style="{DynamicResource PrimaryButton}" Margin="0,0,0,15">
                                <TextBlock x:Name="TestPingBtnText" Text="Test ping" FontSize="13" FontWeight="SemiBold"/>
                            </Button>

                            <!-- Mode Toggle Pill (Proxy | TUN) -->
                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="4" HorizontalAlignment="Center" Width="180">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ProxyModeChip" Grid.Column="0" Click="ProxyModeChip_Click" Content="Proxy" Style="{DynamicResource ModePillBtn}"/>
                                    <Button x:Name="TunModeChip" Grid.Column="1" Click="TunModeChip_Click" Content="TUN" Style="{DynamicResource ModePillBtn}"/>
                                </Grid>
                            </Border>

                            <!-- Floating Overlay Widget Toggle Button -->
                            <Button Click="ToggleOverlayWidget_Click" Margin="0,14,0,0" Style="{DynamicResource SecondaryButton}" Height="32" Width="180">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🔮 " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Floating Widget" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 2. SETTINGS VIEW TAB -->
                <Grid x:Name="SettingsMainView" Visibility="Collapsed" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="VPN Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <!-- Inbound Ports -->
                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Local Inbound Ports" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="HTTP Port:" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="HttpPortBox" TextChanged="HttpPortBox_TextChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="SOCKS Port:" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="SocksPortBox" TextChanged="SocksPortBox_TextChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Options -->
                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Network Options" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="AllowLanCheckBox" Content="Allow LAN Connections (0.0.0.0)" Click="AllowLanCheckBox_Click" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="Remote DNS Server:" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DnsServerBox" TextChanged="DnsServerBox_TextChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Binary Downloader -->
                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="⚡ Sing-Box Core Binary" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Download/Update the sing-box.exe core binary." Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⬇ Download Core" Style="{DynamicResource PrimaryButton}" Click="DownloadCoreBtn_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. PER-APP PROXY VIEW TAB -->
                <Grid x:Name="PerAppMainView" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" Padding="14" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Per-App Mode:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                            <ComboBox x:Name="PerAppModeCombo" Width="200" SelectionChanged="PerAppModeCombo_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="Disabled (All traffic routed by rules)"/>
                                <ComboBoxItem Content="Include (Proxy ONLY selected apps)"/>
                                <ComboBoxItem Content="Exclude (Bypass selected apps)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Running Applications" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="🔄 Refresh Apps" Style="{DynamicResource SecondaryButton}" Click="RefreshAppsBtn_Click" HorizontalAlignment="Right"/>
                        </Grid>

                        <ListView x:Name="AppsListView" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{DynamicResource ModernListViewItem}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"/>
                                            <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="AppCheckBox_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- 4. LOGS VIEW TAB -->
                <Grid x:Name="LogsMainView" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="Clear Logs" Style="{DynamicResource SecondaryButton}" Click="ClearLogsBtn_Click"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" Padding="10">
                        <ScrollViewer x:Name="LogsScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="LogsBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AppTextBrush}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- MODAL DIALOG OVERLAY: "Add configuration" (Happ Style Modal) -->
        <Grid x:Name="AddConfigModal" Visibility="Collapsed" Background="#80000000">
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" CornerRadius="12" Width="460" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Add configuration" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"/>
                        <Button Click="CloseModal_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right">
                            <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Input Fields -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Type" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ModalTypeCombo" SelectionChanged="ModalTypeCombo_SelectionChanged" Margin="0,0,0,12">
                            <ComboBoxItem Content="Subscription URL"/>
                            <ComboBoxItem Content="Single Link / JSON Config"/>
                        </ComboBox>

                        <TextBlock x:Name="ModalNameLabel" Text="Subscription Name" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ModalNameBox" Margin="0,0,0,12"/>

                        <TextBlock x:Name="ModalUrlLabel" Text="Subscription URL or Link (VLESS/VMess/SS/JSON)" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ModalUrlBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButton}" Click="CloseModal_Click" Margin="0,0,8,0"/>
                        <Button Content="Add" Style="{DynamicResource PrimaryButton}" Click="ConfirmModalAdd_Click" Width="90"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
