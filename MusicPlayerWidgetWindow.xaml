                                <Rectangle Width="13" Height="13" Fill="{StaticResource MiniForegroundBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-volume-loud-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle>
                            </Button>
                            <Slider x:Name="MiniVolumeSliderH" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Large vertical pill volume control. -->
            <Popup x:Name="MiniVolumePopup"
                   PlacementTarget="{Binding ElementName=MiniVolumeButtonV}"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Width="78"
                        Padding="9"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppAccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="24"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.28"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="MiniPopupVolumeText" Text="80%" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,1,0,8"/>
                        <Border Width="50" Height="154" CornerRadius="25" Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="MiniPopupVolumeFill" Height="0" VerticalAlignment="Bottom" CornerRadius="24" Background="{DynamicResource AppAccentFillBrush}"/>
                                <Slider x:Name="MiniVolumePopupSlider" Orientation="Vertical" Minimum="0" Maximum="100" Value="80" Width="50" Height="154" Opacity="0.02" ValueChanged="VolumePopupSlider_ValueChanged" Cursor="Hand"/>
                                <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Bottom" Margin="0,0,0,8" Background="#22FFFFFF">
                                    <Rectangle Width="15" Height="15" Fill="{DynamicResource AppTextBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-volume-loud-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Main Player Content Card (Reverted to Standard Original View) -->
            <Border Grid.Row="1" x:Name="PlayerMainView" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Vinyl Disc Art & Track Info -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rotating Vinyl Disc Cover -->
                        <Grid Grid.Column="0" Width="72" Height="72">
                            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2"/>

                            <Grid x:Name="DiscGroup" Width="72" Height="72" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="DiscRotation" Angle="0"/>
                                </Grid.RenderTransform>

                                <Ellipse Width="70" Height="70" Fill="{DynamicResource AppInputBrush}"/>
                                <Ellipse Width="40" Height="40" Fill="{DynamicResource AppSurfaceAltBrush}" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1"/>

                                <TextBlock Text="🎵" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="AlbumCoverImage" Width="70" Height="70" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Grid>

                        <!-- Track Details & Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock x:Name="TrackTitleTxt" Text="No Track Playing" Foreground="{DynamicResource AppTextBrush}" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TrackArtistTxt" Text="Select a track from playlist" Foreground="{DynamicResource AppAccentBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,5" TextTrimming="CharacterEllipsis"/>

                            <!-- Dynamic Visualizer Bars -->
                            <StackPanel x:Name="EqualizerPanel" Orientation="Horizontal" Height="18" Visibility="Collapsed" VerticalAlignment="Bottom">
                                <Border x:Name="GrooveBar1" Width="4" Height="6" Background="{DynamicResource AppAccentBrush}" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                                <Border x:Name="GrooveBar2" Width="4" Height="10" Background="{DynamicResource AppAccentFillBrush}" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                                <Border x:Name="GrooveBar3" Width="4" Height="15" Background="{DynamicResource AppAccentBrush}" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                                <Border x:Name="GrooveBar4" Width="4" Height="8" Background="{DynamicResource AppAccentFillBrush}" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                                <Border x:Name="GrooveBar5" Width="4" Height="13" Background="{DynamicResource AppAccentBrush}" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                                <Border x:Name="GrooveBar6" Width="4" Height="5" Background="{DynamicResource AppAccentFillBrush}" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                                <Border x:Name="GrooveBar7" Width="4" Height="11" Background="{DynamicResource AppAccentBrush}" CornerRadius="2" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Favorite Heart Toggle -->
                        <Button Grid.Column="2" x:Name="LikeBtn" Content="♥" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="22" Style="{StaticResource CleanIconButton}" Click="LikeBtn_Click" VerticalAlignment="Center" ToolTip="Add to Favorites"/>
                    </Grid>

                    <!-- Cyber Seekbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Slider Grid.Row="0" x:Name="PositionSlider" Style="{StaticResource CyberNeonSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="PositionSlider_ValueChanged" PreviewMouseDown="PositionSlider_PreviewMouseDown" PreviewMouseUp="PositionSlider_PreviewMouseUp" VerticalAlignment="Center" Cursor="Hand"/>
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <TextBlock x:Name="CurrentTimeTxt" Text="00:00" Foreground="{DynamicResource AppAccentBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TotalTimeTxt" Text="00:00" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- Control Buttons Pod -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Shuffle & Repeat -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ShuffleBtn" Width="34" Height="34" Style="{StaticResource CleanIconButton}" Click="ShuffleBtn_Click" Margin="0,0,5,0" ToolTip="Toggle Smart Shuffle"><Rectangle Width="18" Height="18" Fill="{DynamicResource AppMutedTextBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-shuffle-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle></Button>
                            <Button x:Name="RepeatBtn" Width="34" Height="34" Style="{StaticResource CleanIconButton}" Click="RepeatBtn_Click" ToolTip="Repeat: Off / All / One">
                                <Grid Width="18" Height="18">
                                    <Rectangle x:Name="RepeatOffIcon" Fill="{DynamicResource AppMutedTextBrush}">
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-repeat-one-minimalistic-svgrepo-com.png"/></Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Rectangle x:Name="RepeatAllIcon" Fill="{DynamicResource AppAccentBrush}" Visibility="Collapsed">
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-repeat-svgrepo-com.png"/></Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Rectangle x:Name="RepeatOneIcon" Fill="{DynamicResource AppAccentFillBrush}" Visibility="Collapsed">
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-repeat-one-svgrepo-com.png"/></Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Main Buttons: Prev, Play, Next -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="PrevBtn" Width="40" Height="40" Style="{StaticResource CyberCircleButton}" Click="PrevBtn_Click" Margin="0,0,12,0"><Rectangle Width="18" Height="18" Fill="{DynamicResource AppTextBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-skip-previous-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle></Button>
                            <Button x:Name="PlayPauseBtn" Width="48" Height="48" Style="{StaticResource CyberPlayButton}" Click="PlayPauseBtn_Click" Margin="0,0,12,0">
                                <Grid>
                                    <Rectangle x:Name="PlayPauseIcon" Width="21" Height="21" Fill="White"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-play-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle>
                                    <TextBlock x:Name="PauseGlyph" Text="Ⅱ" Foreground="White" FontSize="18" FontWeight="Bold" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="NextBtn" Width="40" Height="40" Style="{StaticResource CyberCircleButton}" Click="NextBtn_Click"><Rectangle Width="18" Height="18" Fill="{DynamicResource AppTextBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-skip-next-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle></Button>
                        </StackPanel>

                        <!-- Volume Slider -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="15" Height="15" Fill="{DynamicResource AppAccentBrush}" Margin="0,0,5,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-volume-loud-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle>
                            <Slider x:Name="VolumeSlider" Width="60" Style="{StaticResource CyberNeonSlider}" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Playlist View & Filter Tabs -->
            <Grid Grid.Row="2" x:Name="PlaylistView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Navigation Tabs Bar with Scroll Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀" Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppSurfaceAltBrush}" BorderThickness="0" FontSize="10" Padding="5,4" Click="ScrollTabLeft_Click" Cursor="Hand" Margin="0,0,4,0" ToolTip="Scroll Tabs Left"/>

                    <ScrollViewer Grid.Column="1" x:Name="TabScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScrollViewer_PreviewMouseWheel">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabQueueBtn" Style="{StaticResource CyberTabButton}" Click="TabQueue_Click"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,4,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-playlist-minimalistic-2-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="Queue"/></StackPanel></Button>
                            <Button x:Name="TabTopPlayedBtn" Style="{StaticResource CyberTabButton}" Click="TabTopPlayed_Click"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,4,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-fire-minimalistic-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="Top"/></StackPanel></Button>
                            <Button x:Name="TabPlaylistsBtn" Style="{StaticResource CyberTabButton}" Click="TabPlaylists_Click"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,4,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-notebook-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="Playlists"/></StackPanel></Button>
                            <Button x:Name="TabAllBtn" Style="{StaticResource CyberTabButton}" Click="TabAll_Click"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,4,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-music-note-2-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="All"/></StackPanel></Button>
                            <Button x:Name="TabGenresBtn" Style="{StaticResource CyberTabButton}" Click="TabGenres_Click"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,4,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-category-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="Genres"/></StackPanel></Button>
                            <Button x:Name="TabArtistsBtn" Content="👤 Artists" Style="{StaticResource CyberTabButton}" Click="TabArtists_Click"/>
                            <Button x:Name="TabFavsBtn" Content="❤️ Favs" Style="{StaticResource CyberTabButton}" Click="TabFavs_Click"/>
                            <Button x:Name="TabHistoryBtn" Style="{StaticResource CyberTabButton}" Click="TabHistory_Click"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,4,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-history-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="History"/></StackPanel></Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Column="2" Content="▶" Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppSurfaceAltBrush}" BorderThickness="0" FontSize="10" Padding="5,4" Click="ScrollTabRight_Click" Cursor="Hand" Margin="4,0,0,0" ToolTip="Scroll Tabs Right"/>
                </Grid>

                <!-- Active Artist Filter Indicator Chip / Banner -->
                <Border x:Name="ArtistFilterBanner" Grid.Row="1" Background="{DynamicResource AppAccentSoftBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 Filtered by Artist: " Foreground="{DynamicResource AppTextBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="FilteredArtistNameTxt" Text="" Foreground="{DynamicResource AppAccentBrush}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Content="✕ Clear Filter" Foreground="#EF4444" Background="Transparent" BorderThickness="0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearArtistFilter_Click" Cursor="Hand" ToolTip="Remove artist filter and show all tracks"/>
                    </Grid>
                </Border>

                <!-- Search & Action Toolbar -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchBox" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}" CaretBrush="{DynamicResource AppTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" FontSize="11" TextChanged="SearchBox_TextChanged" ToolTip="Search tracks by title or artist"/>
                    
                    <ComboBox Grid.Column="1" x:Name="SortComboBox" Height="34" Width="122" Margin="8,0,0,0" Style="{StaticResource CyberComboBoxStyle}" SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Default" IsSelected="True"/>
                        <ComboBoxItem Content="Most Played"/>
                        <ComboBoxItem Content="Title (A-Z)"/>
                        <ComboBoxItem Content="Artist (A-Z)"/>
                        <ComboBoxItem Content="Duration"/>
                    </ComboBox>

                    <Button Grid.Column="2" x:Name="NewPlaylistBtn" Content="＋ New List" Background="{DynamicResource AppAccentFillBrush}" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Padding="8,4" Click="NewPlaylistBtn_Click" Margin="6,0,0,0" Visibility="Collapsed" Cursor="Hand"/>
                    <Button Grid.Column="2" x:Name="ClearQueueBtn" Content="🗑 Clear Queue" Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" FontSize="10" FontWeight="Bold" Padding="8,4" Click="ClearQueueBtn_Click" Margin="6,0,0,0" Visibility="Collapsed" Cursor="Hand"/>
                </Grid>

                <!-- Main Track ListBox with Right-Click Context Menu -->
                <ListBox Grid.Row="3" x:Name="PlaylistListBox"
                         Background="{DynamicResource AppInputBrush}"
                         Foreground="{DynamicResource AppTextBrush}"
                         BorderBrush="{DynamicResource AppBorderBrush}"
                         BorderThickness="1"
                         Padding="0,0,14,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="PlaylistListBox_SelectionChanged">
                    <ListBox.Resources>
                        <ContextMenu x:Key="TrackContextMenu" Style="{StaticResource CyberContextMenu}">
                            <MenuItem Header="⏭ Play Next (Up Next)" Click="ContextPlayNext_Click" Style="{StaticResource CyberMenuItem}"/>
                            <MenuItem Header="➕ Add to Queue" Click="ContextAddToQueue_Click" Style="{StaticResource CyberMenuItem}"/>
                            <Separator Background="{DynamicResource AppBorderBrush}"/>
                            <MenuItem x:Name="AddToPlaylistSubMenu" Header="📂 Add to Custom Playlist..." Style="{StaticResource CyberMenuItem}"/>
                            <MenuItem Header="❤️ Toggle Favorite" Click="ContextToggleFavorite_Click" Style="{StaticResource CyberMenuItem}"/>
                            <Separator Background="{DynamicResource AppBorderBrush}"/>
                            <MenuItem Header="👤 Filter by Artist" Click="ContextFilterArtist_Click" Style="{StaticResource CyberMenuItem}"/>
                            <MenuItem Header="❌ Remove from List" Click="ContextRemoveTrack_Click" Style="{StaticResource CyberMenuItem}"/>
                        </ContextMenu>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource CyberListBoxItemStyle}">
                            <Setter Property="ContextMenu" Value="{StaticResource TrackContextMenu}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TrackCard" CornerRadius="8" Padding="8,6" Margin="2,1,4,1" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover Art Thumbnail -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="{DynamicResource AppSurfaceAltBrush}" Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="🎵" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding AlbumArt}" Width="38" Height="38" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,38,38" RadiusX="6" RadiusY="6"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource AppTextBrush}" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayArtist}" Foreground="{DynamicResource AppAccentBrush}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource CleanIconButton}" FontSize="15" Click="ItemFavorite_Click" Tag="{Binding}" Margin="8,0,8,0" ToolTip="Toggle favorite">
                                        <TextBlock Text="♥">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentFillBrush}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" MinWidth="38" TextAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Custom Playlists List Box -->
                <ListBox Grid.Row="3" x:Name="CustomPlaylistsListBox" Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ItemContainerStyle="{StaticResource CyberListBoxItemStyle}" Visibility="Collapsed" SelectionChanged="CustomPlaylistsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,6" Margin="2,1" Background="{DynamicResource AppSurfaceBrush}" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📜" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppAccentBrush}" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10.5"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✎" Foreground="{DynamicResource AppAccentBrush}" Style="{StaticResource CleanIconButton}" FontSize="14" Click="RenamePlaylist_Click" Tag="{Binding}" Margin="0,0,6,0" ToolTip="Rename Playlist"/>
                                    <Button Grid.Column="3" Content="🗑" Foreground="#EF4444" Style="{StaticResource CleanIconButton}" FontSize="12" Click="DeletePlaylist_Click" Tag="{Binding}" ToolTip="Delete Playlist"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Artists Grouping List View with Real Album Art Avatar -->
                <ListBox Grid.Row="3" x:Name="ArtistsListBox" Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ItemContainerStyle="{StaticResource CyberListBoxItemStyle}" Visibility="Collapsed" SelectionChanged="ArtistsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,6" Margin="2,1" Background="{DynamicResource AppSurfaceBrush}" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Artist Image Avatar -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AppSurfaceAltBrush}" Margin="0,0,12,0">
                                        <Grid>
                                            <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ArtistArt}" Width="40" Height="40" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ArtistName}" Foreground="{DynamicResource AppAccentBrush}" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10.5"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource AppAccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Genres Grouping List View with Real Album Art Avatar -->
                <ListBox Grid.Row="3" x:Name="GenresListBox" Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ItemContainerStyle="{StaticResource CyberListBoxItemStyle}" Visibility="Collapsed" SelectionChanged="GenresListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,6" Margin="2,1" Background="{DynamicResource AppSurfaceBrush}" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Genre Image Avatar -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}" Margin="0,0,12,0">
                                        <Grid>
                                            <TextBlock Text="🎸" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding GenreArt}" Width="40" Height="40" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GenreName}" Foreground="{DynamicResource AppAccentBrush}" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10.5"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource AppAccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Sleek Cyber Loading Overlay -->
            <Grid x:Name="LoadingOverlay" Grid.RowSpan="3" Background="{DynamicResource AppBackgroundBrush}" Opacity="0.97" Visibility="Collapsed">
                <Border CornerRadius="14" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎵" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <ProgressBar Width="160" Height="4" IsIndeterminate="True" Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppSurfaceAltBrush}" BorderThickness="0" Margin="0,0,0,12"/>
                        <TextBlock Text="Loading audio library…" Foreground="{DynamicResource AppTextBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Scanning tracks and reading metadata" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
