<Window x:Class="KeyMapper.MusicPlayerWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Player" Height="620" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Disc Spin Storyboard -->
        <Storyboard x:Key="SpinDiscStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DiscRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:12"/>
        </Storyboard>

        <!-- Custom Cyber Neon Scrollbar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#06B6D4" BorderBrush="Transparent">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="3" Background="#06B6D4">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" Color="#06B6D4" Opacity="0.8" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Spotify-style Cyber Slider Template -->
        <Style x:Key="SpotifySliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Grid.Row="1">
                            <Border x:Name="TrackBackground" Height="5" CornerRadius="2.5" Background="#1E293B" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="5" CornerRadius="2.5" Background="#06B6D4">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="#06B6D4" Opacity="0.8" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse x:Name="ThumbEllipse" Width="12" Height="12" Fill="#F8FAFC" Stroke="#06B6D4" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" Color="#06B6D4" Opacity="0.9" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbEllipse" Property="Width" Value="15"/>
                                                        <Setter TargetName="ThumbEllipse" Property="Height" Value="15"/>
                                                        <Setter TargetName="ThumbEllipse" Property="Fill" Value="#06B6D4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F2070B14" BorderBrush="#06B6D4" BorderThickness="1.8" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" Color="#06B6D4" Opacity="0.45" ShadowDepth="0"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- Title Header & Actions -->
                <RowDefinition Height="Auto"/>
                <!-- Player Main Card (Vinyl Disc, Title, Artist, Seekbar, Controls, Volume) -->
                <RowDefinition Height="Auto"/>
                <!-- Playlist View & Tabs -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="#06B6D4" Margin="0,0,8,0">
                        <TextBlock Text="🎵" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Music Player" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ManageFoldersBtn" Content="📁 Folders" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Padding="10,4" Click="ManageFoldersBtn_Click" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="TogglePlaylistBtn" Content="📋 Playlist" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Padding="10,4" Click="TogglePlaylistBtn_Click" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="➖" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="MinimizeBtn_Click" Margin="0,0,8,0" Cursor="Hand" ToolTip="Minimize Widget"/>
                    <Button Content="✕" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="Bold" Click="CloseBtn_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Main Player Content Card -->
            <Border Grid.Row="1" x:Name="PlayerMainView" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.5" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Vinyl Disc Art & Track Info -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rotating Vinyl Disc Cover -->
                        <Grid Grid.Column="0" Width="76" Height="76">
                            <Border Width="76" Height="76" CornerRadius="38" Background="#0B0F19" BorderBrush="#06B6D4" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" Color="#06B6D4" Opacity="0.6" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Grid x:Name="DiscGroup" Width="76" Height="76" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="DiscRotation" Angle="0"/>
                                </Grid.RenderTransform>

                                <Ellipse Width="74" Height="74" Fill="#0B0F19"/>
                                <Ellipse Width="44" Height="44" Fill="#1E293B" Stroke="#334155" StrokeThickness="1"/>

                                <TextBlock Text="🎵" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="AlbumCoverImage" Width="74" Height="74" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="37,37" RadiusX="37" RadiusY="37"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Grid>

                        <!-- Track Details & Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="TrackTitleTxt" Text="No Track Playing" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TrackArtistTxt" Text="Select a track from playlist" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,6" TextTrimming="CharacterEllipsis"/>

                            <!-- Dynamic Visualizer Bars -->
                            <StackPanel x:Name="EqualizerPanel" Orientation="Horizontal" Height="14" Visibility="Collapsed">
                                <Border Width="3" Height="12" Background="#06B6D4" CornerRadius="1.5" Margin="0,0,3,0"/>
                                <Border Width="3" Height="7" Background="#38BDF8" CornerRadius="1.5" Margin="0,0,3,0"/>
                                <Border Width="3" Height="14" Background="#818CF8" CornerRadius="1.5" Margin="0,0,3,0"/>
                                <Border Width="3" Height="9" Background="#C084FC" CornerRadius="1.5" Margin="0,0,3,0"/>
                                <Border Width="3" Height="5" Background="#06B6D4" CornerRadius="1.5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Favorite Heart Toggle (Red Heart Accent) -->
                        <Button Grid.Column="2" x:Name="LikeBtn" Content="🤍" Foreground="#EF4444" FontSize="20" Background="Transparent" BorderThickness="0" Click="LikeBtn_Click" VerticalAlignment="Center" Cursor="Hand" ToolTip="Add to Favorites"/>
                    </Grid>

                    <!-- Spotify-style Cyber Seekbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Slider Grid.Row="0" x:Name="PositionSlider" Style="{StaticResource SpotifySliderStyle}" Minimum="0" Maximum="100" Value="0" ValueChanged="PositionSlider_ValueChanged" VerticalAlignment="Center" Cursor="Hand"/>
                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <TextBlock x:Name="CurrentTimeTxt" Text="00:00" Foreground="#06B6D4" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TotalTimeTxt" Text="00:00" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- Futuristic Floating Control Pods -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Shuffle & Repeat -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ShuffleBtn" Content="🔀" Width="34" Height="34" FontSize="13" Foreground="#94A3B8" Background="#1E293B" BorderThickness="0" Click="ShuffleBtn_Click" Margin="0,0,6,0" Cursor="Hand" ToolTip="Shuffle Active Queue"/>
                            <Button x:Name="RepeatBtn" Content="🔁" Width="34" Height="34" FontSize="13" Foreground="#94A3B8" Background="#1E293B" BorderThickness="0" Click="RepeatBtn_Click" Cursor="Hand" ToolTip="Repeat Track"/>
                        </StackPanel>

                        <!-- Main Buttons: Prev, Play, Next -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="PrevBtn" Content="⏮" Width="42" Height="42" FontSize="16" Foreground="#F8FAFC" Background="#1E293B" BorderBrush="#06B6D4" BorderThickness="1.5" Click="PrevBtn_Click" Margin="0,0,14,0" Cursor="Hand"/>
                            <Button x:Name="PlayPauseBtn" Content="▶" Width="54" Height="54" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Background="#06B6D4" BorderThickness="0" Click="PlayPauseBtn_Click" Margin="0,0,14,0" Cursor="Hand">
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="18" Color="#06B6D4" Opacity="0.85" ShadowDepth="0"/>
                                </Button.Effect>
                            </Button>
                            <Button x:Name="NextBtn" Content="⏭" Width="42" Height="42" FontSize="16" Foreground="#F8FAFC" Background="#1E293B" BorderBrush="#06B6D4" BorderThickness="1.5" Click="NextBtn_Click" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Volume Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔊" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Slider x:Name="VolumeSlider" Width="64" Style="{StaticResource SpotifySliderStyle}" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Playlist View & Filter Tabs -->
            <Grid Grid.Row="2" x:Name="PlaylistView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Tabs: Now Playing Queue | All Tracks | Artists | Favorites -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="TabQueueBtn" Content="▶ Playing Queue" Background="#06B6D4" Foreground="#0F172A" BorderThickness="0" FontSize="10.5" FontWeight="Bold" Padding="10,5" Click="TabQueue_Click" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button x:Name="TabAllBtn" Content="🎵 All" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" FontSize="10.5" FontWeight="Bold" Padding="10,5" Click="TabAll_Click" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button x:Name="TabArtistsBtn" Content="👤 Artists" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" FontSize="10.5" FontWeight="Bold" Padding="10,5" Click="TabArtists_Click" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button x:Name="TabFavsBtn" Content="❤️ Favorites" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" FontSize="10.5" FontWeight="Bold" Padding="10,5" Click="TabFavs_Click" Cursor="Hand"/>
                </StackPanel>

                <!-- Search Input -->
                <TextBox Grid.Row="1" x:Name="SearchBox" Height="32" Padding="10,4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11.5" TextChanged="SearchBox_TextChanged" Margin="0,0,0,10" ToolTip="Search by Title or Artist..."/>

                <!-- Track List View with Real Album Art Thumbnails & Active Playing Highlight -->
                <ListBox Grid.Row="2" x:Name="PlaylistListBox" Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" SelectionChanged="PlaylistListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="6,4" Margin="2,2" Background="{Binding CardBackground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover Art Thumbnail -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#1E293B" Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="🎵" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding AlbumArt}" Width="36" Height="36" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,36,36" RadiusX="6" RadiusY="6"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="{Binding TitleBrush}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayArtist}" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="{Binding FavoriteIcon}" Foreground="{Binding FavoriteColor}" Background="Transparent" BorderThickness="0" FontSize="12" Click="ItemFavorite_Click" Tag="{Binding}" Margin="8,0,8,0" Cursor="Hand"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Artists Grouping List View -->
                <ListBox Grid.Row="2" x:Name="ArtistsListBox" Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" Visibility="Collapsed" SelectionChanged="ArtistsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="👤" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ArtistName}" Foreground="#38BDF8" FontSize="12.5" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" Foreground="#64748B" FontSize="10.5"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" Foreground="#06B6D4" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</Window>
