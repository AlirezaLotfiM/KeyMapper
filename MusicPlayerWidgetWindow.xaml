<Window x:Class="KeyMapper.MusicPlayerWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyMapper Cyber Music Player" Height="650" Width="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Taskbar Thumbnail Media Button Vector Icons -->
        <DrawingImage x:Key="TaskbarPlayIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#EC4899">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 3,2 L 15,10 L 3,18 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="TaskbarPauseIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#EC4899">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="3,2,4,16"/>
                            <RectangleGeometry Rect="11,2,4,16"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="TaskbarPrevIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#A855F7">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="2,2,3,16"/>
                            <PathGeometry Figures="M 15,2 L 5,10 L 15,18 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="TaskbarNextIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#A855F7">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="13,2,3,16"/>
                            <PathGeometry Figures="M 3,2 L 13,10 L 3,18 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Disc Spin Storyboard -->
        <Storyboard x:Key="SpinDiscStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DiscRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:12"/>
        </Storyboard>

        <!-- Custom Cyber Neon Scrollbar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#06B6D4" BorderBrush="Transparent">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="3" Background="#06B6D4">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" Color="#06B6D4" Opacity="0.8" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Spotify-style Cyber Slider Template -->
        <Style x:Key="SpotifySliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Grid.Row="1">
                            <Border x:Name="TrackBackground" Height="5" CornerRadius="2.5" Background="#1E293B" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="5" CornerRadius="2.5" Background="#06B6D4">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="#06B6D4" Opacity="0.8" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse x:Name="ThumbEllipse" Width="12" Height="12" Fill="#F8FAFC" Stroke="#06B6D4" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" Color="#06B6D4" Opacity="0.9" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbEllipse" Property="Width" Value="15"/>
                                                        <Setter TargetName="ThumbEllipse" Property="Height" Value="15"/>
                                                        <Setter TargetName="ThumbEllipse" Property="Fill" Value="#06B6D4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Context Menu Style -->
        <Style x:Key="CyberContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="BorderBrush" Value="#06B6D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style x:Key="CyberMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <!-- Transparent Icon Button Style with Soft Purple Hover Highlight -->
        <Style x:Key="CleanIconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2B1A4C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D256D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Circle Control Button Style (Prev/Next) -->
        <Style x:Key="CyberCircleButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1A1230"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#8B5CF6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#311F58"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#EC4899"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#482E80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Play Statement Center Button -->
        <Style x:Key="CyberPlayButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="playBorder" CornerRadius="25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EC4899" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="playShadow" BlurRadius="16" Color="#EC4899" Opacity="0.8" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="playBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F472B6" Offset="0"/>
                                            <GradientStop Color="#A855F7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="playBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Cyber Tab Button Style -->
        <Style x:Key="CyberTabButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1A1230"/>
            <Setter Property="Foreground" Value="#C084FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="TabBorder" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2B1A4C"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sleek Cyber Glassmorphism ComboBox Style -->
        <Style x:Key="CyberComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#1A1230"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#8B5CF6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" Color="#8B5CF6" Opacity="0.3" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0 Z" Fill="#C084FC"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#251745"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#EC4899"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#EC4899"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#EC4899"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide" Placement="Bottom">
                                <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#120A24" BorderBrush="#8B5CF6" BorderThickness="1.2" CornerRadius="10" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.8" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas Height="0" Width="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Rectangle x:Name="OpaqueRect" Height="{Binding ActualHeight, ElementName=DropDownBorder}" Width="{Binding ActualWidth, ElementName=DropDownBorder}" Fill="#120A24"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2,2,2,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B1A4C"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3B236E"/>
                                <Setter Property="Foreground" Value="#EC4899"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Neon Slider Style -->
        <Style x:Key="CyberNeonSlider" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="#1E1535"/>
            <Setter Property="Foreground" Value="#A855F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="#A855F7" Height="4" CornerRadius="2">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" Color="#A855F7" Opacity="0.85" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="#261B40" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse Width="12" Height="12" Fill="#F8FAFC" Stroke="#EC4899" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="#EC4899" Opacity="0.9" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber ListBox Item Container Style (Stretches 100% Full Width) -->
        <Style x:Key="CyberListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="2,1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#22173E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#22173E"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#A855F7"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="PlayerTaskbarItem">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="TaskbarPrevBtn" Description="Previous Track" ImageSource="{StaticResource TaskbarPrevIcon}" Click="TaskbarPrev_Click"/>
                <ThumbButtonInfo x:Name="TaskbarPlayPauseBtn" Description="Play / Pause" ImageSource="{StaticResource TaskbarPlayIcon}" Click="TaskbarPlayPause_Click"/>
                <ThumbButtonInfo x:Name="TaskbarNextBtn" Description="Next Track" ImageSource="{StaticResource TaskbarNextIcon}" Click="TaskbarNext_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Border x:Name="OuterWindowBorder" Background="#F50B0716" BorderBrush="#A855F7" BorderThickness="1.8" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect x:Name="OuterGlowEffect" BlurRadius="35" Color="#A855F7" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>
        <Grid x:Name="MainRootGrid" Margin="16">
            <Grid.RowDefinitions>
                <!-- Title Header & Actions -->
                <RowDefinition Height="Auto"/>
                <!-- Player Main Card (Vinyl Disc, Title, Artist, Seekbar, Controls, Volume) -->
                <RowDefinition Height="Auto"/>
                <!-- Playlist View & Tabs -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" x:Name="HeaderGrid" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="#A855F7" Margin="0,0,8,0">
                        <TextBlock Text="🎵" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Cyber-Pro Music Engine" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ManageFoldersBtn" Content="📁 Folders" Background="#1E1535" Foreground="#C084FC" BorderBrush="#A855F7" BorderThickness="1" FontSize="10" FontWeight="Bold" Padding="8,4" Click="ManageFoldersBtn_Click" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button Content="➖" Foreground="#C084FC" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="MinimizeBtn_Click" Margin="0,0,6,0" Cursor="Hand" ToolTip="Minimize to Mini Player"/>
                    <Button Content="✕" Foreground="#EF4444" Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="Bold" Click="CloseBtn_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Super Compact Floating Mini Player Deck -->
            <Grid x:Name="MiniDeckView" Grid.RowSpan="3" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="150" Margin="0">
                    <!-- Top Bar: Title, Expand, Close -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎵" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mini" Foreground="#A855F7" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="MiniLikeBtn" Content="🤍" Foreground="#EF4444" Style="{StaticResource CleanIconButton}" FontSize="12" Click="LikeBtn_Click" Margin="0,0,6,0" ToolTip="Add to Favorites"/>
                            <Button Content="↗" Foreground="#38BDF8" Style="{StaticResource CleanIconButton}" FontSize="12" FontWeight="Bold" Click="ExpandMiniPlayer_Click" Margin="0,0,6,0" ToolTip="Expand Full Player"/>
                            <Button Content="✕" Foreground="#EF4444" Style="{StaticResource CleanIconButton}" FontSize="11" FontWeight="Bold" Click="CloseBtn_Click" ToolTip="Close Player"/>
                        </StackPanel>
                    </Grid>

                    <!-- Album Cover Art (Rounded Square) -->
                    <Border Width="85" Height="85" CornerRadius="10" Background="#0E091F" BorderBrush="#A855F7" BorderThickness="1.2" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#A855F7" Opacity="0.6" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="🎵" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="MiniCoverImage" Width="85" Height="85" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,85,85" RadiusX="10" RadiusY="10"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Marquee Track Details -->
                    <TextBlock x:Name="MiniTrackTitleTxt" Text="No Track Playing" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                    <TextBlock x:Name="MiniTrackArtistTxt" Text="Select a song" Foreground="#C084FC" FontSize="9.5" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                    <!-- Compact Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button Content="⏮" Width="30" Height="30" FontSize="12" Style="{StaticResource CyberCircleButton}" Click="PrevBtn_Click" Margin="0,0,8,0"/>
                        <Button x:Name="MiniPlayPauseBtn" Content="▶" Width="34" Height="34" FontSize="14" FontWeight="Bold" Style="{StaticResource CyberPlayButton}" Click="PlayPauseBtn_Click"/>
                        <Button Content="⏭" Width="30" Height="30" FontSize="12" Style="{StaticResource CyberCircleButton}" Click="NextBtn_Click" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Neon Mini Seekbar Progress -->
                    <Grid Width="135" Margin="0,0,0,6" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Slider Grid.Row="0" x:Name="MiniPositionSlider" Style="{StaticResource CyberNeonSlider}" Minimum="0" Maximum="100" ValueChanged="PositionSlider_ValueChanged" PreviewMouseDown="PositionSlider_PreviewMouseDown" PreviewMouseUp="PositionSlider_PreviewMouseUp" Cursor="Hand"/>
                        <Grid Grid.Row="1" Margin="0,1,0,0">
                            <TextBlock x:Name="MiniCurrentTimeTxt" Text="00:00" Foreground="#A855F7" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="MiniTotalTimeTxt" Text="00:00" Foreground="#94A3B8" FontSize="8.5" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- Neon Volume Slider -->
                    <Grid HorizontalAlignment="Center" Width="135" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔊" Foreground="#C084FC" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Grid.Column="1" x:Name="MiniVolumeSlider" Style="{StaticResource CyberNeonSlider}" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Main Player Content Card -->
            <Border Grid.Row="1" x:Name="PlayerMainView" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.5" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Vinyl Disc Art & Track Info -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rotating Vinyl Disc Cover -->
                        <Grid Grid.Column="0" Width="72" Height="72">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#0B0F19" BorderBrush="#06B6D4" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" Color="#06B6D4" Opacity="0.6" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Grid x:Name="DiscGroup" Width="72" Height="72" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="DiscRotation" Angle="0"/>
                                </Grid.RenderTransform>

                                <Ellipse Width="70" Height="70" Fill="#0B0F19"/>
                                <Ellipse Width="40" Height="40" Fill="#1E293B" Stroke="#334155" StrokeThickness="1"/>

                                <TextBlock Text="🎵" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="AlbumCoverImage" Width="70" Height="70" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Grid>

                        <!-- Track Details & Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock x:Name="TrackTitleTxt" Text="No Track Playing" Foreground="#F8FAFC" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TrackArtistTxt" Text="Select a track from playlist" Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,5" TextTrimming="CharacterEllipsis"/>

                            <!-- Dynamic Visualizer Bars -->
                            <StackPanel x:Name="EqualizerPanel" Orientation="Horizontal" Height="12" Visibility="Collapsed">
                                <Border Width="3" Height="10" Background="#06B6D4" CornerRadius="1.5" Margin="0,0,3,0"/>
                                <Border Width="3" Height="6" Background="#38BDF8" CornerRadius="1.5" Margin="0,0,3,0"/>
                                <Border Width="3" Height="12" Background="#818CF8" CornerRadius="1.5" Margin="0,0,3,0"/>
                                <Border Width="3" Height="8" Background="#C084FC" CornerRadius="1.5" Margin="0,0,3,0"/>
                                <Border Width="3" Height="4" Background="#06B6D4" CornerRadius="1.5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Favorite Heart Toggle -->
                        <Button Grid.Column="2" x:Name="LikeBtn" Content="🤍" Foreground="#EF4444" FontSize="20" Style="{StaticResource CleanIconButton}" Click="LikeBtn_Click" VerticalAlignment="Center" ToolTip="Add to Favorites"/>
                    </Grid>

                    <!-- Cyber Seekbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Slider Grid.Row="0" x:Name="PositionSlider" Style="{StaticResource CyberNeonSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="PositionSlider_ValueChanged" PreviewMouseDown="PositionSlider_PreviewMouseDown" PreviewMouseUp="PositionSlider_PreviewMouseUp" VerticalAlignment="Center" Cursor="Hand"/>
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <TextBlock x:Name="CurrentTimeTxt" Text="00:00" Foreground="#06B6D4" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TotalTimeTxt" Text="00:00" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- Control Buttons Pod -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Shuffle & Repeat -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ShuffleBtn" Content="🔀" Width="34" Height="34" FontSize="13" Foreground="#C084FC" Style="{StaticResource CleanIconButton}" Click="ShuffleBtn_Click" Margin="0,0,5,0" ToolTip="Toggle Smart Shuffle"/>
                            <Button x:Name="RepeatBtn" Content="🔁" Width="34" Height="34" FontSize="13" Foreground="#C084FC" Style="{StaticResource CleanIconButton}" Click="RepeatBtn_Click" ToolTip="Repeat: Off / All / One"/>
                        </StackPanel>

                        <!-- Main Buttons: Prev, Play, Next -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="PrevBtn" Content="⏮" Width="40" Height="40" FontSize="16" Style="{StaticResource CyberCircleButton}" Click="PrevBtn_Click" Margin="0,0,12,0"/>
                            <Button x:Name="PlayPauseBtn" Content="▶" Width="48" Height="48" FontSize="20" FontWeight="Bold" Style="{StaticResource CyberPlayButton}" Click="PlayPauseBtn_Click" Margin="0,0,12,0"/>
                            <Button x:Name="NextBtn" Content="⏭" Width="40" Height="40" FontSize="16" Style="{StaticResource CyberCircleButton}" Click="NextBtn_Click"/>
                        </StackPanel>

                        <!-- Volume Slider -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔊" Foreground="#38BDF8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Slider x:Name="VolumeSlider" Width="60" Style="{StaticResource CyberNeonSlider}" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Playlist View & Filter Tabs -->
            <Grid Grid.Row="2" x:Name="PlaylistView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Navigation Tabs Bar with Scroll Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0" FontSize="10" Padding="5,4" Click="ScrollTabLeft_Click" Cursor="Hand" Margin="0,0,4,0" ToolTip="Scroll Tabs Left"/>

                    <ScrollViewer Grid.Column="1" x:Name="TabScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScrollViewer_PreviewMouseWheel">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabQueueBtn" Content="▶ Queue" Style="{StaticResource CyberTabButton}" Click="TabQueue_Click"/>
                            <Button x:Name="TabTopPlayedBtn" Content="🔥 Top" Style="{StaticResource CyberTabButton}" Click="TabTopPlayed_Click"/>
                            <Button x:Name="TabPlaylistsBtn" Content="📜 Playlists" Style="{StaticResource CyberTabButton}" Click="TabPlaylists_Click"/>
                            <Button x:Name="TabAllBtn" Content="🎵 All" Style="{StaticResource CyberTabButton}" Click="TabAll_Click"/>
                            <Button x:Name="TabGenresBtn" Content="🎸 Genres" Style="{StaticResource CyberTabButton}" Click="TabGenres_Click"/>
                            <Button x:Name="TabArtistsBtn" Content="👤 Artists" Style="{StaticResource CyberTabButton}" Click="TabArtists_Click"/>
                            <Button x:Name="TabFavsBtn" Content="❤️ Favs" Style="{StaticResource CyberTabButton}" Click="TabFavs_Click"/>
                            <Button x:Name="TabHistoryBtn" Content="🕒 History" Style="{StaticResource CyberTabButton}" Click="TabHistory_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Column="2" Content="▶" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0" FontSize="10" Padding="5,4" Click="ScrollTabRight_Click" Cursor="Hand" Margin="4,0,0,0" ToolTip="Scroll Tabs Right"/>
                </Grid>

                <!-- Search & Action Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchBox" Height="30" Padding="8,3" Background="#1A1230" Foreground="#F8FAFC" BorderBrush="#8B5CF6" BorderThickness="1" FontSize="11" TextChanged="SearchBox_TextChanged" ToolTip="Search tracks by Title or Artist..."/>
                    
                    <ComboBox Grid.Column="1" x:Name="SortComboBox" Height="30" Width="110" Margin="6,0,0,0" Style="{StaticResource CyberComboBoxStyle}" SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Default" IsSelected="True"/>
                        <ComboBoxItem Content="Most Played"/>
                        <ComboBoxItem Content="Title (A-Z)"/>
                        <ComboBoxItem Content="Artist (A-Z)"/>
                        <ComboBoxItem Content="Duration"/>
                    </ComboBox>

                    <Button Grid.Column="2" x:Name="NewPlaylistBtn" Content="➕ New List" Background="#06B6D4" Foreground="#0F172A" BorderThickness="0" FontSize="10" FontWeight="Bold" Padding="8,4" Click="NewPlaylistBtn_Click" Margin="6,0,0,0" Visibility="Collapsed" Cursor="Hand"/>
                    <Button Grid.Column="2" x:Name="ClearQueueBtn" Content="🗑 Clear Queue" Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" FontSize="10" FontWeight="Bold" Padding="8,4" Click="ClearQueueBtn_Click" Margin="6,0,0,0" Visibility="Collapsed" Cursor="Hand"/>
                </Grid>

                <!-- Main Track ListBox with Right-Click Context Menu -->
                <ListBox Grid.Row="2" x:Name="PlaylistListBox" Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" SelectionChanged="PlaylistListBox_SelectionChanged">
                    <ListBox.Resources>
                        <ContextMenu x:Key="TrackContextMenu" Style="{StaticResource CyberContextMenu}">
                            <MenuItem Header="⏭ Play Next (Up Next)" Click="ContextPlayNext_Click" Style="{StaticResource CyberMenuItem}"/>
                            <MenuItem Header="➕ Add to Queue" Click="ContextAddToQueue_Click" Style="{StaticResource CyberMenuItem}"/>
                            <Separator Background="#1E293B"/>
                            <MenuItem x:Name="AddToPlaylistSubMenu" Header="📂 Add to Custom Playlist..." Style="{StaticResource CyberMenuItem}"/>
                            <MenuItem Header="❤️ Toggle Favorite" Click="ContextToggleFavorite_Click" Style="{StaticResource CyberMenuItem}"/>
                            <Separator Background="#1E293B"/>
                            <MenuItem Header="👤 Filter by Artist" Click="ContextFilterArtist_Click" Style="{StaticResource CyberMenuItem}"/>
                            <MenuItem Header="❌ Remove from List" Click="ContextRemoveTrack_Click" Style="{StaticResource CyberMenuItem}"/>
                        </ContextMenu>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource CyberListBoxItemStyle}">
                            <Setter Property="ContextMenu" Value="{StaticResource TrackContextMenu}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,6" Margin="2,1" Background="{Binding CardBackground}" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover Art Thumbnail -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="#1E293B" Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="🎵" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding AlbumArt}" Width="38" Height="38" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,38,38" RadiusX="6" RadiusY="6"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="{Binding TitleBrush}" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayArtist}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Play Count Badge -->
                                    <TextBlock Grid.Column="2" Text="{Binding PlayCountText}" Foreground="#06B6D4" FontSize="10" FontWeight="Bold" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="{Binding FavoriteIcon}" Foreground="{Binding FavoriteColor}" Style="{StaticResource CleanIconButton}" FontSize="13" Click="ItemFavorite_Click" Tag="{Binding}" Margin="6,0,6,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Custom Playlists List Box -->
                <ListBox Grid.Row="2" x:Name="CustomPlaylistsListBox" Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" ItemContainerStyle="{StaticResource CyberListBoxItemStyle}" Visibility="Collapsed" SelectionChanged="CustomPlaylistsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,6" Margin="2,1" Background="#0F172A" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📜" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="#06B6D4" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" Foreground="#64748B" FontSize="10.5"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✏️" Foreground="#38BDF8" Style="{StaticResource CleanIconButton}" FontSize="12" Click="RenamePlaylist_Click" Tag="{Binding}" Margin="0,0,6,0" ToolTip="Rename Playlist"/>
                                    <Button Grid.Column="3" Content="🗑" Foreground="#EF4444" Style="{StaticResource CleanIconButton}" FontSize="12" Click="DeletePlaylist_Click" Tag="{Binding}" ToolTip="Delete Playlist"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Artists Grouping List View with Real Album Art Avatar -->
                <ListBox Grid.Row="2" x:Name="ArtistsListBox" Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" ItemContainerStyle="{StaticResource CyberListBoxItemStyle}" Visibility="Collapsed" SelectionChanged="ArtistsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,6" Margin="2,1" Background="#0F172A" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Artist Image Avatar -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#1E293B" Margin="0,0,12,0">
                                        <Grid>
                                            <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ArtistArt}" Width="40" Height="40" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ArtistName}" Foreground="#38BDF8" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" Foreground="#64748B" FontSize="10.5"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" Foreground="#06B6D4" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Genres Grouping List View with Real Album Art Avatar -->
                <ListBox Grid.Row="2" x:Name="GenresListBox" Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" ItemContainerStyle="{StaticResource CyberListBoxItemStyle}" Visibility="Collapsed" SelectionChanged="GenresListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,6" Margin="2,1" Background="#0F172A" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Genre Image Avatar -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                                        <Grid>
                                            <TextBlock Text="🎸" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding GenreArt}" Width="40" Height="40" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GenreName}" Foreground="#C084FC" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" Foreground="#64748B" FontSize="10.5"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" Foreground="#C084FC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Sleek Cyber Loading Overlay -->
                <Grid x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#EA090518" Visibility="Collapsed">
                    <Border CornerRadius="20" Background="#18102C" BorderBrush="#8B5CF6" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" Color="#8B5CF6" Opacity="0.7" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎵" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <ProgressBar Width="160" Height="4" IsIndeterminate="True" Foreground="#EC4899" Background="#261B40" BorderThickness="0" Margin="0,0,0,12"/>
                            <TextBlock Text="Loading Audio Library..." Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Scanning tracks &amp; reading metadata" Foreground="#C084FC" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
