<Window x:Class="KeyMapper.ManageMusicFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Music Folders" Height="340" Width="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1.5" CornerRadius="14" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Color="#000000" Opacity="0.22" ShadowDepth="3"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8"
                            Background="{DynamicResource AppAccentSoftBrush}"
                            Margin="0,0,10,0">
                        <Rectangle Width="17" Height="17"
                                   Fill="{DynamicResource AppAccentBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Resources/Icons/music-add-folder-svgrepo-com.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Manage music folders"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose where KeyMapper looks for songs."
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕"
                        Foreground="{DynamicResource AppMutedTextBrush}"
                        Background="Transparent" BorderThickness="0"
                        FontSize="14" FontWeight="Bold"
                        Width="30" Height="30"
                        HorizontalAlignment="Right"
                        Click="CloseBtn_Click" Cursor="Hand"/>
            </Grid>

            <!-- Folders List -->
            <ListBox Grid.Row="1" x:Name="FoldersListBox"
                     Background="{DynamicResource AppInputBrush}"
                     Foreground="{DynamicResource AppTextBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     BorderThickness="1" Padding="8"
                     Margin="0,0,0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Remove"
                                    Tag="{Binding}" Click="RemoveFolder_Click"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    Foreground="{DynamicResource AppTextBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1" FontSize="10"
                                    Padding="9,4" Cursor="Hand"
                                    Margin="10,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddFolderBtn"
                        Background="{DynamicResource AppAccentFillBrush}"
                        Foreground="White" BorderThickness="0"
                        FontSize="11" FontWeight="SemiBold"
                        Padding="13,7"
                        Click="AddFolderBtn_Click" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,5,0"/>
                        <TextBlock Text="Add folder"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
