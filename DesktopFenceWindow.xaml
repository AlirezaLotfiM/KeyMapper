<Window x:Class="KeyMapper.DesktopFenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="FenceRoot"
        Title="Desktop Fence" Height="340" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        AllowDrop="True"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        DragOver="Window_DragOver" Drop="Window_Drop"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Circle Palette Swatch Button Style (matching Sticky Notes) -->
        <Style x:Key="PaletteCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Floating Action Icon Button -->
        <Style x:Key="SidebarIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Grid: Column 0 = Main Fence, Column 1 = Exterior Sidebar with 8px Gap -->
    <Grid x:Name="RootGrid" Background="Transparent" Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMN 0: MAIN FENCE CONTAINER (CLIPPED WITH PERFECT 16PX CORNER RADIUS) -->
        <Border Grid.Column="0"
                x:Name="MainShell"
                CornerRadius="16"
                Background="#181824"
                BorderBrush="#33FFFFFF"
                BorderThickness="1.2"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.25"/>
            </Border.Effect>
            <Grid x:Name="ShellContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ENTIRE TOP BAR ROW (DRAGGABLE & DOUBLE-CLICK COLLAPSIBLE ANYWHERE ON ROW) -->
                <Grid Grid.Row="0"
                      x:Name="HeaderRowGrid"
                      Background="Transparent"
                      Height="46"
                      MouseLeftButtonDown="HeaderRow_MouseLeftButtonDown">
                    <!-- COMPACT TITLE HEADER PILL -->
                    <Border x:Name="HeaderBorder"
                            HorizontalAlignment="Left"
                            Background="#221E1E2E"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="10,8,10,4"
                            Padding="12,5,14,5">
                        <Grid>
                            <!-- Title Text -->
                            <TextBlock x:Name="TitleTxt"
                                       Text="Fence Title"
                                       Foreground="#F1F5F9"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="Double-click to collapse/expand"
                                       MouseDown="TitleTxt_MouseDown"/>
                            <TextBox x:Name="TitleEditBox"
                                     Text="Fence Title"
                                     Foreground="#FFFFFF"
                                     Background="#2A2A40"
                                     BorderBrush="#A855F7"
                                     BorderThickness="1"
                                     FontSize="12"
                                     Padding="4,2"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"
                                     KeyDown="TitleEditBox_KeyDown"
                                     LostFocus="TitleEditBox_LostFocus"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Main Content Body (No visible scrollbar, mouse wheel scroll active) -->
                <Grid Grid.Row="1" x:Name="ContentGrid" Background="Transparent">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="6">
                            <Grid>
                                <!-- Custom Shortcuts Desktop Grid -->
                                <ItemsControl x:Name="ShortcutsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="82" Height="84" Margin="3" CornerRadius="12" Background="Transparent" Cursor="Hand" ToolTip="{Binding TargetPath}" MouseLeftButtonDown="ShortcutItem_Click" MouseRightButtonUp="ShortcutItem_RightClick">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#22FFFFFF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Margin="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Real Target Icon / Image Thumbnail Container -->
                                                    <Border Grid.Row="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" ClipToBounds="True">
                                                        <Image Source="{Binding ShellIcon}" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                                                    </Border>

                                                    <!-- Title Label -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{Binding ElementName=TitleTxt, Path=Foreground}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Folder Portal Desktop Grid -->
                                <StackPanel x:Name="FolderPortalPanel" Visibility="Collapsed">
                                    <ItemsControl x:Name="FolderPortalItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="82" Height="84" Margin="3" CornerRadius="12" Background="Transparent" Cursor="Hand" ToolTip="{Binding TargetPath}" MouseLeftButtonDown="PortalItem_Click" MouseRightButtonUp="PortalItem_RightClick">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid Margin="3">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Real Native Icon / Image Thumbnail Container -->
                                                        <Border Grid.Row="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" ClipToBounds="True">
                                                            <Image Source="{Binding ShellIcon}" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                                                        </Border>

                                                        <!-- File / Folder Title -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{Binding ElementName=TitleTxt, Path=Foreground}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Empty Drop Prompt -->
                                <TextBlock x:Name="EmptyPromptTxt" Text="Drag &amp; Drop files or apps here" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </ScrollViewer>

                    <!-- Resize Grip Thumb at Bottom-Right -->
                    <Thumb x:Name="ResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Path Data="M 8,14 L 14,8 M 11,14 L 14,11 M 14,14 L 14,14" Stroke="#94A3B8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>

        <!-- COLUMN 1: EXTERIOR FLOATING SIDEBAR MENU (HIDDEN SCROLLBAR, TYPE-SPECIFIC ACTIONS) -->
        <Border Grid.Column="1"
                x:Name="SidebarMenuBorder"
                VerticalAlignment="Top"
                Margin="8,4,0,0"
                Background="#B01E1E2E"
                BorderBrush="#44FFFFFF"
                BorderThickness="1.2"
                CornerRadius="10"
                Padding="2"
                Opacity="0.0"
                IsHitTestVisible="True"
                MouseLeftButtonDown="SidebarMenu_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.3"/>
            </Border.Effect>
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">
                    <!-- Color Theme Swatch Picker (Popup Toggle) -->
                    <Button x:Name="PaletteMenuBtn" Style="{StaticResource SidebarIconButton}" ToolTip="Color Palette &amp; Dark/Light Mode" Click="PaletteMenuBtn_Click">
                        <TextBlock Text="🎨" FontSize="12"/>
                    </Button>

                    <!-- Transparency Settings (Popup Toggle) -->
                    <Button x:Name="OpacityMenuBtn" Style="{StaticResource SidebarIconButton}" ToolTip="Background Transparency" Click="OpacityMenuBtn_Click">
                        <TextBlock Text="💧" FontSize="12"/>
                    </Button>

                    <!-- Add File / Shortcut Button (ONLY for Icon / CustomShortcuts Fences) -->
                    <Button x:Name="AddShortcutBtn" Style="{StaticResource SidebarIconButton}" ToolTip="Add File / Shortcut" Click="AddItemBtn_Click">
                        <TextBlock Text="➕" FontSize="11"/>
                    </Button>

                    <!-- Edit Folder Portal Path Button (ONLY for Folder Portal Fences) -->
                    <Button x:Name="EditPortalBtn" Style="{StaticResource SidebarIconButton}" ToolTip="Change Folder Path..." Click="EditPortalBtn_Click" Visibility="Collapsed">
                        <TextBlock Text="✏️" FontSize="11"/>
                    </Button>

                    <!-- Collapse / Expand Fence -->
                    <Button x:Name="CollapseBtn" Style="{StaticResource SidebarIconButton}" ToolTip="Collapse / Expand" Click="CollapseBtn_Click">
                        <TextBlock x:Name="CollapseTxt" Text="▲" FontSize="10"/>
                    </Button>

                    <!-- Delete Fence with Confirmation Dialog -->
                    <Button x:Name="DeleteFenceBtn" Style="{StaticResource SidebarIconButton}" ToolTip="Delete Fence" Foreground="#EF4444" Click="DeleteFenceBtn_Click">
                        <TextBlock Text="🗑️" FontSize="11"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- COLOR PALETTE & DARK/LIGHT POPUP (MATCHING STICKY NOTES) -->
        <Popup x:Name="PalettePopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=PaletteMenuBtn}" Placement="Left">
            <Border Background="#1E1E2C" BorderBrush="#33FFFFFF" BorderThickness="1.2" CornerRadius="12" Padding="8" Margin="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel Width="170">
                    <TextBlock Text="Color Theme" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,4"/>

                    <!-- Swatches Row 1 -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#E9D5FF" ToolTip="Lavender" Click="ThemeCircle_Click" Tag="Lavender"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#BAE6FD" ToolTip="Sky Blue" Click="ThemeCircle_Click" Tag="Sky Blue"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#FBCFE8" ToolTip="Pastel Pink" Click="ThemeCircle_Click" Tag="Pastel Pink"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#A7F3D0" ToolTip="Soft Mint" Click="ThemeCircle_Click" Tag="Soft Mint"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#FEF08A" ToolTip="Warm Yellow" Click="ThemeCircle_Click" Tag="Warm Yellow"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#FEF3C7" ToolTip="Warm Cream" Click="ThemeCircle_Click" Tag="Warm Cream"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#334155" ToolTip="Dark Carbon" Click="ThemeCircle_Click" Tag="Dark Carbon"/>
                    </WrapPanel>

                    <!-- Dark / Light Mode Toggle Button -->
                    <Border Background="#2A2A3E" CornerRadius="6" Padding="4,2" Margin="0,2">
                        <Button x:Name="DarkLightToggleBtn" Background="Transparent" BorderThickness="0" Foreground="#F1F5F9" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="DarkLightToggleBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="DarkLightIconTxt" Text="🌙" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DarkLightTextTxt" Text="Dark Mode"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- TRANSPARENCY POPUP -->
        <Popup x:Name="OpacityPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=OpacityMenuBtn}" Placement="Left">
            <Border Background="#1E1E2C" BorderBrush="#33FFFFFF" BorderThickness="1.2" CornerRadius="12" Padding="8" Margin="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel Width="150">
                    <TextBlock Text="Background Opacity" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,6"/>
                    <Button Style="{StaticResource SidebarIconButton}" Width="134" HorizontalContentAlignment="Left" Content=" 100% Solid" Click="OpacityOption_Click" Tag="1.0"/>
                    <Button Style="{StaticResource SidebarIconButton}" Width="134" HorizontalContentAlignment="Left" Content=" 85% Soft Glass" Click="OpacityOption_Click" Tag="0.85"/>
                    <Button Style="{StaticResource SidebarIconButton}" Width="134" HorizontalContentAlignment="Left" Content=" 65% Translucent" Click="OpacityOption_Click" Tag="0.65"/>
                    <Button Style="{StaticResource SidebarIconButton}" Width="134" HorizontalContentAlignment="Left" Content=" 45% Clear Glass" Click="OpacityOption_Click" Tag="0.45"/>
                    <Button Style="{StaticResource SidebarIconButton}" Width="134" HorizontalContentAlignment="Left" Content=" 20% Ultra Clear" Click="OpacityOption_Click" Tag="0.20"/>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</Window>
