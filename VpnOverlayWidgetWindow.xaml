<Window x:Class="KeyMapper.VpnOverlayWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyMapper"
        Title="KeyMapper Edge Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="320"
        Height="680"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Shutdown.svg Power Geometry -->
        <PathGeometry x:Key="ShutdownIconGeometry">M14.984375 2.9863281 A 1.0001 1.0001 0 0 0 14 4L14 15 A 1.0001 1.0001 0 1 0 16 15L16 4 A 1.0001 1.0001 0 0 0 14.984375 2.9863281 z M 9.9960938 4.2128906 A 1.0001 1.0001 0 0 0 9.5449219 4.328125C5.6645289 6.3141271 3 10.347825 3 15C3 21.615466 8.3845336 27 15 27C21.615466 27 27 21.615466 27 15C27 10.347825 24.335471 6.3141271 20.455078 4.328125 A 1.0001544 1.0001544 0 1 0 19.544922 6.109375C22.780529 7.7653729 25 11.110175 25 15C25 20.534534 20.534534 25 15 25C9.4654664 25 5 20.534534 5 15C5 11.110175 7.2194712 7.7653729 10.455078 6.109375 A 1.0001 1.0001 0 0 0 9.9960938 4.2128906 z</PathGeometry>

        <!-- Ultra Slim Minimal ScrollBar Style -->
        <Style x:Key="SlimWidgetScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="3"/>
            <Setter Property="MinWidth" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Margin="1,2,1,2">
                            <Border Background="#10000000" CornerRadius="1.5"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb MinHeight="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#55000000" CornerRadius="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#88000000"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Style="{StaticResource SlimWidgetScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Liquid Glass Vertical Action Pill Button Style -->
        <Style x:Key="LiquidGlassButton" TargetType="Button">
            <Setter Property="Background" Value="#1A000000"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,2.5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2E000000"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#12000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Colored Button Style -->
        <Style x:Key="AccentGlassButton" TargetType="Button" BasedOn="{StaticResource LiquidGlassButton}">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Module Container Header -->
        <Style x:Key="ModuleHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="2,8,0,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Module Separator -->
        <Style x:Key="ModuleSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="Margin" Value="4,7,4,3"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" HorizontalAlignment="Right" VerticalAlignment="Stretch">

        <!-- ================= LEVEL 1: NARROW EDGE PANEL (STRICTLY VERTICAL) ================= -->
        <Border x:Name="Level1Panel"
                Width="175"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,0,10,0"
                Background="#E6F1F5F9"
                BorderBrush="#75FFFFFF"
                BorderThickness="1.2,1.2,0,1.2"
                CornerRadius="28,0,0,28"
                Visibility="Collapsed"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Direction="180" Color="#000000" Opacity="0.22"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Bar -->
                    <RowDefinition Height="*"/>    <!-- Strictly Vertical Content -->
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0" Padding="12,8" Background="#10000000" BorderBrush="#12000000" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Edge Panel" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ClosePanel_Click" Padding="4">
                            <TextBlock Text="✕" FontSize="10" Foreground="#64748B"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- STRICTLY VERTICAL STACKED MODULES -->
                <local:SmoothScrollViewer Grid.Row="1" Style="{StaticResource WidgetScrollViewer}" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="10,6">
                    <StackPanel>

                        <!-- ================= MODULE 1: VPN ================= -->
                        <TextBlock Text="VPN" Style="{StaticResource ModuleHeaderLabel}" Foreground="#0284C7"/>

                        <!-- Button 1: Connect / Disconnect -->
                        <Button x:Name="VpnLevel1ToggleBtn" Style="{StaticResource AccentGlassButton}" Click="VpnConnectToggle_Click" Background="#0EA5E9">
                            <TextBlock x:Name="VpnLevel1BtnText" Text="Connect" FontWeight="Bold" FontSize="11"/>
                        </Button>

                        <!-- Button 2: View Servers -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="OpenVpnServersLevel2_Click">
                            <TextBlock Text="View Servers →" FontSize="10.5"/>
                        </Button>

                        <Border Style="{StaticResource ModuleSeparator}"/>

                        <!-- ================= MODULE 2: MUSIC PLAYER ================= -->
                        <TextBlock Text="MUSIC" Style="{StaticResource ModuleHeaderLabel}" Foreground="#7C3AED"/>

                        <!-- Cover / Album Art Area -->
                        <Border Width="80" Height="80" CornerRadius="16" Background="#207C3AED" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,2,0,4">
                            <Grid>
                                <TextBlock Text="🎵" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B5CF6"/>
                                <Image x:Name="L1MusicCoverImg" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="L1MusicTitleText" Text="No Track Playing" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                        <!-- Strictly Vertical Controls (One Under The Other) -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="MusicPlayPause_Click">
                            <TextBlock x:Name="L1MusicPlayPauseText" Text="▶ Play" FontWeight="Bold" FontSize="10.5"/>
                        </Button>

                        <Button Style="{StaticResource LiquidGlassButton}" Click="MusicNext_Click">
                            <TextBlock Text="⏭ Next Track" FontSize="10.5"/>
                        </Button>

                        <Button Style="{StaticResource LiquidGlassButton}" Click="MusicPrev_Click">
                            <TextBlock Text="⏮ Previous Track" FontSize="10.5"/>
                        </Button>

                        <Border Style="{StaticResource ModuleSeparator}"/>

                        <!-- ================= MODULE 3: FENCE ================= -->
                        <TextBlock Text="FENCES" Style="{StaticResource ModuleHeaderLabel}" Foreground="#E11D48"/>

                        <!-- Button 1: Add Fence Shortcut -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="CreateNewFence_Click">
                            <TextBlock Text="➕ Add Fence Shortcut" FontSize="10"/>
                        </Button>

                        <!-- Button 2: Add Fence Folder -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="CreatePortalFence_Click">
                            <TextBlock Text="📁 Add Fence Folder" FontSize="10"/>
                        </Button>

                        <Border Style="{StaticResource ModuleSeparator}"/>

                        <!-- ================= MODULE 4: STICKY NOTE ================= -->
                        <TextBlock Text="STICKY NOTES" Style="{StaticResource ModuleHeaderLabel}" Foreground="#059669"/>

                        <!-- Button 1: Add Note -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="CreateNewNote_Click">
                            <TextBlock Text="➕ Add Note" FontWeight="Bold" FontSize="10.5" Foreground="#059669"/>
                        </Button>

                        <!-- Button 2: Show All Notes -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="ShowAllNotes_Click">
                            <TextBlock Text="👁 Show All" FontSize="10.5"/>
                        </Button>

                        <!-- Button 3: Hide All Notes -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="HideAllNotes_Click">
                            <TextBlock Text="🚫 Hide All" FontSize="10.5"/>
                        </Button>

                    </StackPanel>
                </local:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- ================= LEVEL 2: EXPANDED VPN SERVERS PANEL ================= -->
        <Border x:Name="Level2Panel"
                Width="265"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,0,10,0"
                Background="#EAF1F5F9"
                BorderBrush="#85FFFFFF"
                BorderThickness="1.2,1.2,0,1.2"
                CornerRadius="28,0,0,28"
                Visibility="Collapsed"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="0" Direction="180" Color="#000000" Opacity="0.25"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Level2SlideTransform" X="280"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Bar / Back -->
                    <RowDefinition Height="*"/>    <!-- Strictly Vertical Content -->
                </Grid.RowDefinitions>

                <!-- Top Bar with Back Button -->
                <Border Grid.Row="0" Padding="10,8" Background="#10000000" BorderBrush="#12000000" BorderThickness="0,0,0,1">
                    <Grid>
                        <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BackToLevel1_Click" Padding="4">
                            <TextBlock Text="← Back" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                        </Button>
                        <TextBlock Text="VPN Servers" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ClosePanel_Click" Padding="4">
                            <TextBlock Text="✕" FontSize="10" Foreground="#64748B"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- STRICTLY VERTICAL EXPANDED PANEL -->
                <local:SmoothScrollViewer Grid.Row="1" Style="{StaticResource WidgetScrollViewer}" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="12,8">
                    <StackPanel>

                        <!-- Main Connect / Disconnect Action Button -->
                        <Button x:Name="VpnLevel2ToggleBtn" Style="{StaticResource AccentGlassButton}" Click="VpnConnectToggle_Click" Background="#0EA5E9" Height="36" Margin="0,2,0,4">
                            <TextBlock x:Name="VpnLevel2BtnText" Text="Connect to Selected" FontWeight="Bold" FontSize="11.5"/>
                        </Button>

                        <!-- Speed Test Button -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="PingAll_Click" Margin="0,2,0,4">
                            <TextBlock Text="⚡ Speed Test (Ping All)" FontSize="10.5" Foreground="#D97706" FontWeight="SemiBold"/>
                        </Button>

                        <!-- Update Subscriptions Button -->
                        <Button Style="{StaticResource LiquidGlassButton}" Click="UpdateSubs_Click" Margin="0,2,0,6">
                            <TextBlock Text="🔄 Update Subscriptions" FontSize="10.5" Foreground="#0284C7" FontWeight="SemiBold"/>
                        </Button>

                        <!-- Live Traffic Status -->
                        <Border Background="#12000000" CornerRadius="10" Padding="8,5" Margin="0,0,0,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="L2TrafficText" Text="▲ 0 B/s   •   ▼ 0 B/s" FontSize="9.5" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Server List Label -->
                        <TextBlock Text="SELECT SERVER" Style="{StaticResource ModuleHeaderLabel}" Margin="2,4,0,3" HorizontalAlignment="Left"/>

                        <!-- Vertical Server List -->
                        <ItemsControl x:Name="ServersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#70FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="10" Margin="0,2.5" Padding="8,6" Cursor="Hand" MouseLeftButtonUp="ServerRow_MouseLeftButtonUp" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#A8FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#700284C7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="22" Height="15" CornerRadius="3" Background="#200284C7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CountryCodeDisplay}" FontSize="8.5" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <Border Grid.Column="2" Background="#14000000" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding PingDisplay}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding PingColorBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </local:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- ================= SAMSUNG ONE UI LIQUID GLASS EDGE HANDLE ================= -->
        <Border x:Name="EdgeHandle"
                Width="8"
                Height="130"
                CornerRadius="4,0,0,4"
                Background="#60FFFFFF"
                BorderBrush="#45FFFFFF"
                BorderThickness="1,1,0,1"
                Cursor="Hand"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Opacity="0.45"
                PreviewMouseLeftButtonDown="EdgeHandle_PreviewMouseLeftButtonDown"
                PreviewMouseMove="EdgeHandle_PreviewMouseMove"
                PreviewMouseLeftButtonUp="EdgeHandle_PreviewMouseLeftButtonUp"
                MouseRightButtonUp="EdgeHandle_MouseRightButtonUp"
                MouseEnter="EdgeHandle_MouseEnter"
                MouseLeave="EdgeHandle_MouseLeave"
                ToolTip="Click: Open Edge Panel • Drag: Reposition Handle">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
            </Border.Effect>
        </Border>

    </Grid>
</Window>
