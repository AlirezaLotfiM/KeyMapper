<Window x:Class="KeyMapper.VpnOverlayWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyMapper"
        Title="KeyMapper VPN Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="78"
        Height="78"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Shutdown.svg Power Geometry -->
        <PathGeometry x:Key="ShutdownIconGeometry">M14.984375 2.9863281 A 1.0001 1.0001 0 0 0 14 4L14 15 A 1.0001 1.0001 0 1 0 16 15L16 4 A 1.0001 1.0001 0 0 0 14.984375 2.9863281 z M 9.9960938 4.2128906 A 1.0001 1.0001 0 0 0 9.5449219 4.328125C5.6645289 6.3141271 3 10.347825 3 15C3 21.615466 8.3845336 27 15 27C21.615466 27 27 21.615466 27 15C27 10.347825 24.335471 6.3141271 20.455078 4.328125 A 1.0001544 1.0001544 0 1 0 19.544922 6.109375C22.780529 7.7653729 25 11.110175 25 15C25 20.534534 20.534534 25 15 25C9.4654664 25 5 20.534534 5 15C5 11.110175 7.2194712 7.7653729 10.455078 6.109375 A 1.0001 1.0001 0 0 0 9.9960938 4.2128906 z</PathGeometry>

        <!-- Ultra Slim Minimal ScrollBar Style (Clearly Visible & Sleek) -->
        <Style x:Key="SlimWidgetScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Margin="1,4,3,4">
                            <!-- Track Rail -->
                            <Border Background="#22FFFFFF" CornerRadius="3"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#A0CBD5E1" CornerRadius="3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Style="{StaticResource SlimWidgetScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Action Button Style -->
        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10" Opacity="0.40">
        <!-- Main Power Orb Capsule (Draggable Floating Handle) -->
        <Border x:Name="OrbContainer"
                Width="58"
                Height="58"
                CornerRadius="29"
                Background="#2A0E1320"
                BorderBrush="#38FFFFFF"
                BorderThickness="1.5"
                Cursor="Hand"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PreviewMouseLeftButtonDown="Orb_PreviewMouseLeftButtonDown"
                PreviewMouseMove="Orb_PreviewMouseMove"
                PreviewMouseLeftButtonUp="Orb_PreviewMouseLeftButtonUp"
                MouseRightButtonUp="Orb_MouseRightButtonUp"
                ToolTip="Left-Click: Connect/Disconnect • Right-Click: Server List">

            <Grid>
                <!-- Connecting Rotating Dashed Arc (Visible ONLY when connecting) -->
                <Ellipse x:Name="OrbConnectingRing"
                         Width="52"
                         Height="52"
                         Stroke="#F59E0B"
                         StrokeThickness="2"
                         StrokeDashArray="3 3"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="ConnectingRotate" Angle="0" CenterX="26" CenterY="26"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Single Clean Power Vector Symbol from shutdown.svg -->
                <Path x:Name="OrbPowerIcon"
                      Data="{StaticResource ShutdownIconGeometry}"
                      Fill="#EF4444"
                      Width="26"
                      Height="26"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

                <!-- Mini Status / 2-Letter Country Indicator Badge on Orb -->
                <Border x:Name="OrbFlagBadge"
                        Width="20"
                        Height="14"
                        Background="#1E293B"
                        BorderBrush="#8838BDF8"
                        BorderThickness="1"
                        CornerRadius="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,1,1">
                    <TextBlock x:Name="OrbFlagText" Text="UN" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Attached Server Flyout Popup (Opens to Left or Right without moving the Orb!) -->
        <Popup x:Name="ServerFlyoutPopup"
               PlacementTarget="{Binding ElementName=OrbContainer}"
               Placement="Left"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               HorizontalOffset="-10"
               VerticalOffset="0"
               Opened="ServerFlyoutPopup_Opened"
               Closed="ServerFlyoutPopup_Closed">

            <Border x:Name="FlyoutDrawer"
                    Width="340"
                    Background="#FA0D111A"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1.2"
                    CornerRadius="18"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.8"/>
                </Border.Effect>

                <Grid Width="340" MaxHeight="400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Traffic Bar -->
                        <RowDefinition Height="*"/>    <!-- Server List -->
                        <RowDefinition Height="Auto"/> <!-- Footer Info -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#161C2C" BorderBrush="#30FFFFFF" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="FlyoutStatusDot" Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="FlyoutStatusText" Text="DISCONNECTED" FontSize="11" FontWeight="Bold" Foreground="#EF4444" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                    <!-- Active Server Country Code Badge -->
                                    <Border Width="26" Height="18" CornerRadius="4" Background="#1E2B42" BorderBrush="#4038BDF8" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="FlyoutActiveCountryText" Text="UN" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="FlyoutActiveServerText" Text="No Server Selected" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Top Action Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UpdateSubsBtn" Style="{StaticResource WidgetIconButton}" ToolTip="Update All Subscriptions (بروزرسانی اشتراک‌ها)" Click="UpdateSubs_Click" Margin="2,0">
                                    <TextBlock Text="🔄" FontSize="12" Foreground="#38BDF8"/>
                                </Button>
                                <Button x:Name="PingAllBtn" Style="{StaticResource WidgetIconButton}" ToolTip="Test All Latencies (تست تاخیر)" Click="PingAll_Click" Margin="2,0">
                                    <TextBlock Text="⚡" FontSize="13" Foreground="#F59E0B"/>
                                </Button>
                                <Button Style="{StaticResource WidgetIconButton}" ToolTip="Open VPN Manager" Click="OpenVpnManager_Click" Margin="2,0">
                                    <TextBlock Text="🛡️" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource WidgetIconButton}" ToolTip="Close Drawer" Click="CloseFlyout_Click" Margin="2,0">
                                    <TextBlock Text="✕" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Real-time Traffic Bar -->
                    <Border Grid.Row="1" Background="#0A0E17" Padding="12,6" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="▲" FontSize="10" Foreground="#38BDF8" Margin="0,0,5,0"/>
                                <TextBlock x:Name="FlyoutUpSpeedText" Text="0 B/s" FontSize="11" Foreground="#CBD5E1" FontWeight="Medium"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="▼" FontSize="10" Foreground="#4ADE80" Margin="0,0,5,0"/>
                                <TextBlock x:Name="FlyoutDownSpeedText" Text="0 B/s" FontSize="11" Foreground="#CBD5E1" FontWeight="Medium"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Smooth Scroll Server List -->
                    <local:SmoothScrollViewer Grid.Row="2" Style="{StaticResource WidgetScrollViewer}" VerticalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="VerticalOnly" Margin="0,4,8,4" MaxHeight="250">
                        <ItemsControl x:Name="ServersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ServerRow"
                                            Background="#151B28"
                                            BorderBrush="#253348"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="8,3,8,3"
                                            Padding="10,8"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="ServerRow_MouseLeftButtonUp"
                                            Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#222E44"/>
                                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Country Code Badge -->
                                                <ColumnDefinition Width="*"/>    <!-- Name & Details -->
                                                <ColumnDefinition Width="Auto"/> <!-- Ping Badge -->
                                            </Grid.ColumnDefinitions>

                                            <!-- 2-Letter Country Code Pill Badge -->
                                            <Border Grid.Column="0"
                                                    Width="28"
                                                    Height="20"
                                                    CornerRadius="5"
                                                    Background="#1E2B42"
                                                    BorderBrush="#4038BDF8"
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CountryCodeDisplay}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#38BDF8"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name & Protocol -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Border Background="#25354E" CornerRadius="4" Padding="5,1.5" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding ProtocolBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding AddressDisplay}" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Ping Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{Binding PingBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,0,0">
                                                <TextBlock Text="{Binding PingDisplay}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding PingColorBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </local:SmoothScrollViewer>

                    <!-- Footer Info -->
                    <Border Grid.Row="3" Background="#0F1420" Padding="12,6" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock x:Name="FlyoutServerCountText" Text="0 Servers" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="Click server to connect" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
