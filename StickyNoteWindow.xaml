                                <Line x:Name="PinIconSlash" X1="3" Y1="3" X2="21" Y2="21" Stroke="#EF4444" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Hide Note Button -->
                    <Button x:Name="HideNoteButton" Style="{StaticResource SidebarIconButton}" ToolTip="Hide Note from Desktop" Click="HideNoteButton_Click">
                        <TextBlock Text="👁️" FontSize="11"/>
                    </Button>

                    <!-- Theme Picker -->
                    <Button x:Name="ThemeButton" Style="{StaticResource SidebarIconButton}" ToolTip="Color Theme &amp; Palette" Click="ThemeButton_Click">
                        <TextBlock Text="🎨"/>
                    </Button>

                    <!-- New Note Button -->
                    <Button x:Name="NewNoteButton" Style="{StaticResource SidebarIconButton}" ToolTip="New Note" Click="NewNoteButton_Click">
                        <TextBlock Text="➕" FontSize="11"/>
                    </Button>

                    <!-- Fold Button -->
                    <Button x:Name="FoldButton" Style="{StaticResource SidebarIconButton}" ToolTip="Fold / Expand" Click="FoldButton_Click">
                        <TextBlock x:Name="FoldIconText" Text="🔼"/>
                    </Button>

                    <!-- Delete Button -->
                    <Button x:Name="DeleteButton" Style="{StaticResource SidebarIconButton}" ToolTip="Delete Note" Click="DeleteButton_Click">
                        <TextBlock Text="🗑" FontSize="11"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Expanded Palette Color Swatches Circle Grid Flyout -->
        <Popup x:Name="ThemePopup" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=ThemeButton}" Placement="Left">
            <Border Background="#22000000" CornerRadius="12" Padding="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.18"/>
                </Border.Effect>
                <Border x:Name="ThemePopupCard" Background="#FFFFFF" BorderBrush="#D5D5D5" BorderThickness="1" CornerRadius="11" Padding="8" ClipToBounds="True" SnapsToDevicePixels="True">
                    <StackPanel Width="155">
                        <TextBlock Text="🎨 Select Palette" FontWeight="Bold" FontSize="11" Foreground="#333333" Margin="2,0,2,6"/>
                    
                    <!-- Color Swatch Circle Grid -->
                        <WrapPanel Width="150" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#FFF59D" ToolTip="Warm Yellow" Click="ThemeOption_Click" Tag="Warm Yellow"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#F8BBD0" ToolTip="Pastel Pink" Click="ThemeOption_Click" Tag="Pastel Pink"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#A5D6A7" ToolTip="Soft Mint" Click="ThemeOption_Click" Tag="Soft Mint"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#80DEEA" ToolTip="Sky Blue" Click="ThemeOption_Click" Tag="Sky Blue"/>
                        
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#E1BEE7" ToolTip="Lavender" Click="ThemeOption_Click" Tag="Lavender"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#2C2C2C" ToolTip="Dark Carbon" Click="ThemeOption_Click" Tag="Dark Carbon"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#FFF8E7" ToolTip="Warm Cream" Click="ThemeOption_Click" Tag="Warm Cream"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#FF8A80" ToolTip="Coral" Click="ThemeOption_Click" Tag="Coral"/>
                        
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#FFD180" ToolTip="Peach" Click="ThemeOption_Click" Tag="Peach"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#C8E6C9" ToolTip="Sage" Click="ThemeOption_Click" Tag="Sage"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#B2DFDB" ToolTip="Teal" Click="ThemeOption_Click" Tag="Teal"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#C5CAE9" ToolTip="Indigo" Click="ThemeOption_Click" Tag="Indigo"/>

                        <Button Style="{StaticResource PaletteCircleButton}" Background="#D1C4E9" ToolTip="Plum" Click="ThemeOption_Click" Tag="Plum"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#D7CCC8" ToolTip="Mocha" Click="ThemeOption_Click" Tag="Mocha"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#181028" ToolTip="Cyber Neon" Click="ThemeOption_Click" Tag="Cyber Neon"/>
                        <Button Style="{StaticResource PaletteCircleButton}" Background="#2A1B3D" ToolTip="Sunset Purple" Click="ThemeOption_Click" Tag="Sunset Purple"/>
                        </WrapPanel>

                        <Separator Margin="2,6"/>
                        <TextBlock Text="Custom Hex Color" FontSize="10" Foreground="#666666" Margin="2,0,2,3"/>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomHexTextBox" Text="#FFE082" FontSize="11" Padding="4,2"/>
                            <Button Grid.Column="1" Content="Apply" FontSize="10" Margin="4,0,0,0" Padding="6,2" Click="CustomHexApply_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>

        <!-- Text Color Picker Popup -->
        <Popup x:Name="TextColorPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=FormatToolbar}" Placement="Bottom">
            <Border Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="6">
                <WrapPanel Width="120">
                    <Button Width="22" Height="22" Margin="2" Background="#222222" Click="TextColorOption_Click" Tag="#222222" ToolTip="Black"/>
                    <Button Width="22" Height="22" Margin="2" Background="#E53935" Click="TextColorOption_Click" Tag="#E53935" ToolTip="Red"/>
                    <Button Width="22" Height="22" Margin="2" Background="#43A047" Click="TextColorOption_Click" Tag="#43A047" ToolTip="Green"/>
                    <Button Width="22" Height="22" Margin="2" Background="#1E88E5" Click="TextColorOption_Click" Tag="#1E88E5" ToolTip="Blue"/>
                    <Button Width="22" Height="22" Margin="2" Background="#8E24AA" Click="TextColorOption_Click" Tag="#8E24AA" ToolTip="Purple"/>
                    <Button Width="22" Height="22" Margin="2" Background="#FB8C00" Click="TextColorOption_Click" Tag="#FB8C00" ToolTip="Orange"/>
                </WrapPanel>
            </Border>
        </Popup>

        <!-- Text Highlight Picker Popup -->
        <Popup x:Name="HighlightPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=FormatToolbar}" Placement="Bottom">
            <Border Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="6">
                <WrapPanel Width="120">
                    <Button Width="22" Height="22" Margin="2" Background="Transparent" Content="❌" Click="HighlightOption_Click" Tag="Transparent" ToolTip="None"/>
                    <Button Width="22" Height="22" Margin="2" Background="#FFEE58" Click="HighlightOption_Click" Tag="#FFEE58" ToolTip="Yellow"/>
                    <Button Width="22" Height="22" Margin="2" Background="#A5D6A7" Click="HighlightOption_Click" Tag="#A5D6A7" ToolTip="Green"/>
                    <Button Width="22" Height="22" Margin="2" Background="#80DEEA" Click="HighlightOption_Click" Tag="#80DEEA" ToolTip="Cyan"/>
                    <Button Width="22" Height="22" Margin="2" Background="#F8BBD0" Click="HighlightOption_Click" Tag="#F8BBD0" ToolTip="Pink"/>
                    <Button Width="22" Height="22" Margin="2" Background="#FFCC80" Click="HighlightOption_Click" Tag="#FFCC80" ToolTip="Orange"/>
                </WrapPanel>
            </Border>
        </Popup>

        <!-- Modern Styled Target Language Selector Flyout -->
        <Popup x:Name="TranslatePopup" StaysOpen="False" PlacementTarget="{Binding ElementName=FormatToolbar}" Placement="Bottom" Opened="TranslatePopup_Opened">
            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel Width="165">
                    <TextBlock Text="🌐 Target Language" FontWeight="Bold" FontSize="11" Foreground="#333333" Margin="4,2,4,8"/>
                    <!-- Populated dynamically from installed LibreTranslate languages -->
                    <StackPanel x:Name="TranslateLangList"/>
                    <TextBlock x:Name="TranslateLangEmptyHint"
                               Text="No languages installed.&#x0a;Open Settings → Translation&#x0a;to download language packs."
                               FontSize="10" Foreground="#888888"
                               TextWrapping="Wrap" Margin="4,4,4,4"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Table Management & Styling Tools Popup -->
        <Popup x:Name="TablePopup" StaysOpen="False" PlacementTarget="{Binding ElementName=FormatToolbar}" Placement="Bottom">
            <Border Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="6">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="170">
                        <TextBlock Text="📊 Table Tools" FontWeight="Bold" FontSize="11" Margin="4,2,4,6" Foreground="#444444"/>
                        <Button Content="➕ Insert New Table" Margin="2" Click="TableInsertNew_Click"/>
                        <Button Content="⬆️ Add Row Above" Margin="2" Click="TableRowAbove_Click"/>
                        <Button Content="⬇️ Add Row Below" Margin="2" Click="TableRowBelow_Click"/>
                        <Button Content="❌ Delete Row" Margin="2" Click="TableRowDelete_Click"/>
                        <Separator Margin="2,4"/>
                        <Button Content="⬅️ Add Column Left" Margin="2" Click="TableColLeft_Click"/>
                        <Button Content="➡️ Add Column Right" Margin="2" Click="TableColRight_Click"/>
                        <Button Content="❌ Delete Column" Margin="2" Click="TableColDelete_Click"/>
                        
                        <Separator Margin="2,6"/>
                        <TextBlock Text="🎨 Cell Background Color" FontWeight="Bold" FontSize="10" Foreground="#555555" Margin="4,0,4,4"/>
                        <WrapPanel Width="160" Margin="2">
                            <Button Width="22" Height="22" Margin="2" Background="Transparent" Content="❌" Click="TableCellBgOption_Click" Tag="Transparent" ToolTip="Transparent / Default"/>
                            <Button Width="22" Height="22" Margin="2" Background="#FFF59D" Click="TableCellBgOption_Click" Tag="#FFF59D" ToolTip="Yellow"/>
                            <Button Width="22" Height="22" Margin="2" Background="#E1BEE7" Click="TableCellBgOption_Click" Tag="#E1BEE7" ToolTip="Lavender"/>
                            <Button Width="22" Height="22" Margin="2" Background="#A5D6A7" Click="TableCellBgOption_Click" Tag="#A5D6A7" ToolTip="Mint"/>
                            <Button Width="22" Height="22" Margin="2" Background="#80DEEA" Click="TableCellBgOption_Click" Tag="#80DEEA" ToolTip="Sky Blue"/>
                            <Button Width="22" Height="22" Margin="2" Background="#F8BBD0" Click="TableCellBgOption_Click" Tag="#F8BBD0" ToolTip="Pink"/>
                            <Button Width="22" Height="22" Margin="2" Background="#F5F5F5" Click="TableCellBgOption_Click" Tag="#F5F5F5" ToolTip="Gray"/>
                            <Button Width="22" Height="22" Margin="2" Background="#FFE0B2" Click="TableCellBgOption_Click" Tag="#FFE0B2" ToolTip="Peach"/>
                        </WrapPanel>

                        <Separator Margin="2,6"/>
                        <TextBlock Text="🖼️ Table Border Style" FontWeight="Bold" FontSize="10" Foreground="#555555" Margin="4,0,4,4"/>
                        <Button Content="Thin Gray Border" Margin="2" Click="TableBorderOption_Click" Tag="1;#CCCCCC"/>
                        <Button Content="Medium Dark Border" Margin="2" Click="TableBorderOption_Click" Tag="1.5;#444444"/>
                        <Button Content="Thick Accent Border" Margin="2" Click="TableBorderOption_Click" Tag="2;#1E88E5"/>
                        <Button Content="No Border" Margin="2" Click="TableBorderOption_Click" Tag="0;Transparent"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- AI Tools Flyout -->
        <Popup x:Name="AiPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=FormatToolbar}" Placement="Bottom">
            <Border Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="6">
                <StackPanel Width="150">
                    <TextBlock Text="✨ AI Tools" FontWeight="Bold" FontSize="11" Margin="4,2,4,6" Foreground="#444444"/>
                    <Button Content="📝 Summarize Note" Margin="2" Click="AiSummarize_Click"/>
                    <Button Content="✨ Fix Grammar &amp; Spells" Margin="2" Click="AiFixGrammar_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
