<Window x:Class="KeyMapper.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyMapper"
        mc:Ignorable="d"
        Title="Sticky Note"
        Height="240" Width="270"
        MinHeight="90" MinWidth="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 7px Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" Background="#50000000" CornerRadius="3.5"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#A0000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating Sidebar Icon Button Style -->
        <Style x:Key="SidebarIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#30000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="FormatToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ElementName=TitleTextBox, Path=Foreground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Circle Swatch Button Style -->
        <Style x:Key="PaletteCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.18"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRootGrid" Margin="8" 
          MouseEnter="WindowRootGrid_MouseEnter" 
          MouseLeave="WindowRootGrid_MouseLeave"
          MouseLeftButtonDown="WindowRootGrid_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <!-- Main Card Column -->
            <ColumnDefinition Width="*"/>
            <!-- Floating Sidebar Column -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- MAIN CARD BORDER -->
        <Border Grid.Column="0" x:Name="NoteCardBorder" 
                CornerRadius="10" 
                BorderThickness="1.5"
                BorderBrush="#25000000"
                Background="#FFF59D" 
                SnapsToDevicePixels="True"
                SizeChanged="NoteCardBorder_SizeChanged">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.2"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <!-- Row 0: TOP CENTERED TITLE HEADER -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Formatting Toolbar (Multine & Scrollable) -->
                    <RowDefinition Height="Auto" x:Name="FormatBarRow"/>
                    <!-- Row 2: Content Area -->
                    <RowDefinition Height="*"/>
                    <!-- Row 3: Voice Memo Bar -->
                    <RowDefinition Height="Auto" x:Name="AudioBarRow"/>
                    <!-- Row 4: Footer Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP CENTERED TITLE HEADER -->
                <Grid Grid.Row="0" x:Name="TitleBarGrid" Background="#12000000" MinHeight="32" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBox x:Name="TitleTextBox" 
                             Text="Quick Note" 
                             FontWeight="Bold" 
                             FontSize="13" 
                             Foreground="#333333" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Margin="10,5"
                             HorizontalContentAlignment="Center"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Focusable="False"
                             Cursor="Arrow"
                             MouseDoubleClick="TitleTextBox_MouseDoubleClick"
                             LostFocus="TitleTextBox_LostFocus"
                             TextChanged="TitleTextBox_TextChanged"/>
                </Grid>

                <!-- FORMATTING TOOLBAR (EDIT MODE ONLY - MULTILINE WRAPPANEL + SCROLLABLE) -->
                <Border Grid.Row="1" x:Name="FormatToolbar" Background="#12000000" Padding="4,3" BorderThickness="0,0,0,1" BorderBrush="#15000000" Visibility="Collapsed">
                    <ScrollViewer x:Name="FormatToolbarScrollViewer" MaxHeight="66" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel Orientation="Horizontal">
                            <!-- AI & Translate Tools -->
                            <Button Style="{StaticResource FormatToolButton}" Content="🌐 Translate" ToolTip="Translate Note / Selection" Click="TranslateButton_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="✨ AI Assistant" ToolTip="AI Summarize &amp; Fix" Click="AiButton_Click"/>

                            <Rectangle Width="1" Height="14" Fill="#30000000" Margin="4,4"/>

                            <!-- Font Family Selector -->
                            <ComboBox x:Name="FontFamilyCombo" Width="85" Height="22" FontSize="10" Margin="2,2" SelectionChanged="FontFamilyCombo_SelectionChanged" ToolTip="Font Family">
                                <ComboBoxItem Content="Segoe UI" IsSelected="True"/>
                                <ComboBoxItem Content="Vazirmatn"/>
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Consolas"/>
                                <ComboBoxItem Content="Tahoma"/>
                                <ComboBoxItem Content="Comic Sans MS"/>
                            </ComboBox>

                            <!-- Font Size Selector -->
                            <ComboBox x:Name="FontSizeCombo" Width="55" Height="22" FontSize="10" Margin="2,2" SelectionChanged="FontSizeCombo_SelectionChanged" ToolTip="Font Size">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="13" IsSelected="True"/>
                                <ComboBoxItem Content="14"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="18"/>
                                <ComboBoxItem Content="20"/>
                                <ComboBoxItem Content="24"/>
                                <ComboBoxItem Content="28"/>
                                <ComboBoxItem Content="32"/>
                            </ComboBox>

                            <Rectangle Width="1" Height="14" Fill="#30000000" Margin="4,4"/>

                            <!-- Text Formatting -->
                            <Button Style="{StaticResource FormatToolButton}" Content="B" FontWeight="Bold" ToolTip="Bold (Ctrl+B)" Click="BtnBold_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="I" FontStyle="Italic" ToolTip="Italic (Ctrl+I)" Click="BtnItalic_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="U" ToolTip="Underline (Ctrl+U)" Click="BtnUnderline_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="S" ToolTip="Strikethrough" Click="BtnStrikethrough_Click"/>

                            <Rectangle Width="1" Height="14" Fill="#30000000" Margin="4,4"/>

                            <!-- Text Color & Highlight -->
                            <Button Style="{StaticResource FormatToolButton}" Content="🎨 Color" ToolTip="Text Color" Click="BtnTextColor_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="🖍️ Highlight" ToolTip="Text Highlight" Click="BtnHighlight_Click"/>

                            <Rectangle Width="1" Height="14" Fill="#30000000" Margin="4,4"/>

                            <Button Style="{StaticResource FormatToolButton}" Content="H1" ToolTip="Heading 1" Click="BtnH1_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="H2" ToolTip="Heading 2" Click="BtnH2_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="• List" ToolTip="Bullet List" Click="BtnBullet_Click"/>

                            <Rectangle Width="1" Height="14" Fill="#30000000" Margin="4,4"/>

                            <!-- Alignments -->
                            <Button Style="{StaticResource FormatToolButton}" Content="⬅" ToolTip="Align Left" Click="BtnAlignLeft_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="↔" ToolTip="Align Center" Click="BtnAlignCenter_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="➡" ToolTip="Align Right" Click="BtnAlignRight_Click"/>

                            <!-- MS Word Style RTL/LTR Paragraph Direction Buttons -->
                            <Button Style="{StaticResource FormatToolButton}" Content="¶ LTR" ToolTip="Left-to-Right Paragraph Direction (Word style)" Click="BtnLtrParagraph_Click"/>
                            <Button Style="{StaticResource FormatToolButton}" Content="¶ RTL" ToolTip="Right-to-Left Paragraph Direction (Word style)" Click="BtnRtlParagraph_Click"/>

                            <Rectangle Width="1" Height="14" Fill="#30000000" Margin="4,4"/>

                            <!-- 2 Columns Layout Toggle -->
                            <Button x:Name="ColToggleBtn" Style="{StaticResource FormatToolButton}" Content="1 Col" ToolTip="Toggle 1 / 2 Column Layout" Click="ColToggleBtn_Click"/>

                            <!-- Table Tools -->
                            <Button Style="{StaticResource FormatToolButton}" Content="📊 Table" ToolTip="Table Tools Menu" Click="BtnTableMenu_Click"/>
                            <!-- Image Insert -->
                            <Button Style="{StaticResource FormatToolButton}" Content="📷 Image" ToolTip="Insert Image" Click="BtnInsertImage_Click"/>
                            <!-- Voice Memo -->
                            <Button Style="{StaticResource FormatToolButton}" Content="🎙️ Voice" ToolTip="Record Voice Memo" Click="BtnVoiceMemo_Click"/>
                        </WrapPanel>
                    </ScrollViewer>
                </Border>

                <!-- NOTE EDITOR CANVAS -->
                <Grid Grid.Row="2" x:Name="ContentGrid" Margin="4">
                    <RichTextBox x:Name="RichEditor" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="6" 
                                 FontSize="13" 
                                 Foreground="#222222" 
                                 AcceptsReturn="True" 
                                 IsReadOnly="True"
                                 Cursor="Arrow"
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="RichEditor_MouseDoubleClick"
                                 SelectionChanged="RichEditor_SelectionChanged"
                                 TextChanged="RichEditor_TextChanged"/>
                </Grid>

                <!-- VOICE MEMO BAR -->
                <Border Grid.Row="3" x:Name="AudioBar" Background="#20000000" CornerRadius="6" Margin="6,2" Padding="6,3" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AudioPlayButton" Style="{StaticResource SidebarIconButton}" Content="▶" Click="AudioPlayButton_Click"/>
                        <TextBlock x:Name="AudioStatusText" Grid.Column="1" Text="Voice Memo (0.0s)" VerticalAlignment="Center" Margin="6,0" FontSize="11" Foreground="#333333"/>
                        <Button x:Name="AudioRecordButton" Grid.Column="2" Style="{StaticResource SidebarIconButton}" Content="🔴" ToolTip="Record Voice" Click="AudioRecordButton_Click"/>
                        <Button x:Name="AudioDeleteButton" Grid.Column="3" Style="{StaticResource SidebarIconButton}" Content="❌" ToolTip="Remove Audio" Click="AudioDeleteButton_Click"/>
                    </Grid>
                </Border>

                <!-- FOOTER / STATUS BAR (Fades in on hover) -->
                <Grid Grid.Row="4" x:Name="FooterBar" Margin="6,2,6,4" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusLabel" Text="Double-click to edit" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PinBadgeLabel" Grid.Column="1" Text="Pinned" FontSize="10" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center"/>
                </Grid>

                <!-- RESIZE GRIP THUMB INSIDE NOTE CARD BOTTOM-RIGHT CORNER -->
                <Thumb x:Name="NoteResizeThumb" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Bottom" 
                       Grid.Row="2"
                       Grid.RowSpan="3"
                       Width="14" Height="14" 
                       Margin="0,0,3,3" 
                       Cursor="SizeNWSE"
                       DragStarted="NoteResizeThumb_DragStarted"
                       DragDelta="NoteResizeThumb_DragDelta"
                       DragCompleted="NoteResizeThumb_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Path Data="M 6,14 L 14,6 M 10,14 L 14,10" 
                                      Stroke="#888888" 
                                      StrokeThickness="1.5" 
                                      HorizontalAlignment="Right" 
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,2,2"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <!-- SEPARATED FLOATING ACTION SIDEBAR PILL -->
        <Border Grid.Column="1" x:Name="SidebarMenuBorder" 
                Background="#EEFFFFFF" 
                BorderBrush="#25000000"
                BorderThickness="1"
                CornerRadius="12" 
                Padding="3,4" 
                Margin="8,0,0,0" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Left"
                Opacity="0"
                MouseEnter="SidebarMenuBorder_MouseEnter"
                MouseLeave="SidebarMenuBorder_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.25"/>
            </Border.Effect>
            <ScrollViewer x:Name="SidebarScrollViewer" MaxHeight="220" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HeaderActionPanel" Orientation="Vertical" VerticalAlignment="Top">
                    <!-- Done Button (Edit Mode Only - Top of Sidebar) -->
                    <Button x:Name="DoneSidebarButton" Style="{StaticResource SidebarIconButton}" ToolTip="Finish Editing (Done)" Click="DoneEditButton_Click" Visibility="Collapsed">
                        <TextBlock Text="✔" Foreground="#2E7D32" FontWeight="Bold" FontSize="14"/>
                    </Button>

                    <!-- Pin Toggle Button -->
                    <Button x:Name="PinButton" Style="{StaticResource SidebarIconButton}" ToolTip="Pinned (Always On Top)" Click="PinButton_Click">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="PinIconPath" Fill="#333333"
                                      Data="F1 M16.4746 4.3747L19.6474 7.55072C20.6549 8.55917 21.4713 9.37641 21.9969 10.0856C22.5382 10.8161 22.8881 11.5853 22.6982 12.4634C22.5083 13.3415 21.8718 13.8972 21.0771 14.3383C20.3055 14.7665 19.2245 15.1727 17.8906 15.6738L15.9136 16.4166C15.1192 16.7151 14.9028 16.8081 14.742 16.9474C14.6611 17.0174 14.5887 17.0967 14.5263 17.1837C14.4021 17.3568 14.329 17.5812 14.1037 18.4L14.0914 18.4449C13.8627 19.2762 13.6739 19.9623 13.4671 20.4774C13.2573 21.0003 12.974 21.4955 12.465 21.786C12.1114 21.9878 11.7112 22.0936 11.3041 22.093C10.7179 22.0921 10.227 21.8014 9.78647 21.4506C9.35243 21.1049 8.8497 20.6016 8.24065 19.9919L6.65338 18.403L2.5306 22.53C2.23786 22.823 1.76298 22.8233 1.46994 22.5305C1.1769 22.2378 1.17666 21.7629 1.4694 21.4699L5.59326 17.3418L4.05842 15.8054C3.45318 15.1996 2.9536 14.6995 2.61002 14.2678C2.26127 13.8297 1.97215 13.3421 1.96848 12.7599C1.96586 12.3451 2.07354 11.9371 2.28053 11.5777C2.57116 11.0731 3.06341 10.7919 3.58296 10.5834C4.09477 10.3779 4.77597 10.1901 5.60112 9.96265L5.6457 9.95036C6.46601 9.7242 6.69053 9.65088 6.86346 9.52638C6.9526 9.4622 7.0337 9.38748 7.10499 9.30383C7.24338 9.14144 7.33502 8.92324 7.62798 8.12367L8.34447 6.16811C8.83874 4.819 9.23907 3.72629 9.66362 2.9461C10.1005 2.14324 10.654 1.49811 11.5357 1.30359C12.4175 1.10904 13.1908 1.46156 13.9246 2.0063C14.6375 2.53559 15.4597 3.35863 16.4746 4.3747ZM13.0304 3.21067C12.4277 2.76322 12.1086 2.71327 11.8588 2.76836C11.609 2.82349 11.3402 3.0033 10.9812 3.66306C10.6161 4.33394 10.2525 5.32066 9.73087 6.7443L9.03642 8.63971C9.02304 8.67621 9.00987 8.71226 8.99686 8.74786C8.76267 9.3886 8.58179 9.88351 8.24665 10.2768C8.09712 10.4522 7.92696 10.609 7.73987 10.7437C7.3205 11.0456 6.81257 11.1852 6.15537 11.3659C6.11884 11.3759 6.08184 11.3861 6.04438 11.3964C5.16337 11.6393 4.56523 11.8054 4.1418 11.9754C3.71693 12.146 3.615 12.2662 3.58038 12.3263C3.50616 12.4552 3.46751 12.6015 3.46845 12.7504C3.46889 12.8201 3.49835 