<Window x:Class="KeyMapper.SupportDonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support and Donate"
        Width="560"
        Height="690"
        MinWidth="480"
        MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PopupButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PopupButtonBorder" Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                                <Setter TargetName="PopupButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PopupButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource PopupButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppAccentBrush}"
            BorderThickness="2"
            CornerRadius="16"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="7" Direction="270" Color="#000000" Opacity="0.28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="7"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#55CAD3"/>
                <Border Grid.Column="1" Background="#F3BE55"/>
                <Border Grid.Column="2" Background="#E985AE"/>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="22,17,20,14"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        CornerRadius="10"
                        Background="{DynamicResource AppAccentSoftBrush}"
                        BorderBrush="{DynamicResource AppAccentBrush}"
                        BorderThickness="1.5"
                        VerticalAlignment="Top">
                    <Image Source="Resources/Icons/donate.png"
                           Width="21"
                           Height="21"
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock Text="Support and Donate"
                               Foreground="{DynamicResource AppTextBrush}"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Keep Desktop Pet free, thoughtful, and growing."
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource CloseButton}"
                        Content="×"
                        ToolTip="Close"
                        Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,0,14,8">
                <StackPanel>
                    <Border Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="15,13"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Optional support"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="If this free project helps your workflow or brightens your desktop, you can support its continued development. No feature is locked behind a donation, and the app never sends wallet information anywhere."
                                       Foreground="{DynamicResource AppTextBrush}"
                                       FontSize="11"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppAccentSoftBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="13,11"
                            Margin="0,0,0,14">
                        <TextBlock Text="Choose the exact network shown on each card. BEP20, ERC20, TRC20, and TON are not interchangeable. Always verify the asset, network, and address in your wallet before confirming."
                                   Foreground="{DynamicResource AppTextBrush}"
                                   FontSize="11"
                                   LineHeight="17"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ItemsControl x:Name="WalletsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="13"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34"
                                                Height="34"
                                                CornerRadius="9"
                                                Background="{DynamicResource AppSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <Image Source="{Binding IconPath}"
                                                   Width="23"
                                                   Height="23"
                                                   Stretch="Uniform"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <TextBlock Text="{Binding AssetName}"
                                                       Foreground="{DynamicResource AppTextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Network}"
                                                       Foreground="{DynamicResource AppAccentBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="0,2,0,0"/>
                                            <TextBox Text="{Binding Address}"
                                                     IsReadOnly="True"
                                                     Height="31"
                                                     Padding="8,5"
                                                     Margin="0,7,0,0"
                                                     Background="{DynamicResource AppInputBrush}"
                                                     Foreground="{DynamicResource AppTextBrush}"
                                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                                     BorderThickness="1"
                                                     FontSize="10"
                                                     HorizontalScrollBarVisibility="Auto"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Tag="{Binding}"
                                                Style="{StaticResource PopupButton}"
                                                Padding="10,6"
                                                VerticalAlignment="Bottom"
                                                Click="CopyAddress_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Margin="0,0,6,0" Fill="{DynamicResource AppAccentBrush}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="Resources/Icons/copy.png"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Margin="18,0,18,16"
                    Padding="11,9"
                    Background="{DynamicResource AppSurfaceAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock x:Name="CopyStatus"
                           Text="Choose a wallet, then copy its address."
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           FontSize="10.5"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</Window>
