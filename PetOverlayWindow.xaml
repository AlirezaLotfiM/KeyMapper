<Window x:Class="KeyMapper.PetOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyMapper"
        Title="Desktop Pet Assistant"
        Icon="/Resources/app_icon.ico"
        Height="280" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown"
        MouseDoubleClick="PetOverlay_MouseDoubleClick"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <Storyboard x:Key="IdleAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetBodyTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-2" Duration="0:0:2.4" />
            <DoubleAnimation Storyboard.TargetName="PetScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.04" Duration="0:0:1.6" />
        </Storyboard>

    </Window.Resources>

    <Grid x:Name="OverlayRoot" Margin="10" ClipToBounds="True">

        <!-- Speech Bubble Container -->
        <Border x:Name="SpeechBubble"
                Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="12,8"
                Margin="10,0,10,10" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2"
                Visibility="Collapsed" HorizontalAlignment="Center"
                VerticalAlignment="Top" MaxWidth="320" Panel.ZIndex="2">
            <StackPanel>
                <TextBlock x:Name="SpeechBubbleTitle" Text="Chubby Android Pet"
                           Foreground="{DynamicResource AppAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="SpeechBubbleText" Text="Beep boop! Ready to automate!"
                           Foreground="{DynamicResource AppTextBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="120"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <!-- Interactive Reminder Buttons -->
                <StackPanel x:Name="ReminderButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button x:Name="ReminderSnoozeBtn" Content="⏰ 5m Snooze" Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Height="26" FontSize="10" Padding="8,0" Margin="0,0,6,0" Click="ReminderSnoozeBtn_Click"/>
                    <Button x:Name="ReminderDismissBtn" Content="✓ OK" Background="{DynamicResource AppAccentBrush}" Foreground="#FFFFFF" BorderThickness="0" Height="26" FontSize="10" FontWeight="Bold" Padding="10,0" Click="ReminderDismissBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Pet Hover Mini Music Control Overlay (Double Click Opens Music Player Widget) -->
        <Border x:Name="PetMusicControlsOverlay"
                Background="{DynamicResource AppSurfaceBrush}" CornerRadius="10" Padding="10,7"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1.5"
                Visibility="Collapsed" HorizontalAlignment="Center"
                VerticalAlignment="Bottom" Margin="0,0,0,138" Panel.ZIndex="3"
                MouseLeftButtonDown="PetMusicOverlay_MouseLeftButtonDown"
                MouseEnter="PetMusicControlsOverlay_MouseEnter"
                MouseLeave="PetMusicControlsOverlay_MouseLeave">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="13" Height="13" Fill="{DynamicResource AppAccentBrush}" Margin="2,0,5,0">
                    <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-music-note-2-svgrepo-com.png"/></Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock x:Name="PetTrackTitleTxt" Text="Music Player" Foreground="{DynamicResource AppTextBrush}" FontSize="11" FontWeight="SemiBold" MaxWidth="122" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Foreground="{DynamicResource AppTextBrush}" Background="Transparent" BorderThickness="0" Click="PetPrevBtn_Click" Cursor="Hand" Margin="0,0,4,0">
                    <Rectangle Width="13" Height="13" Fill="{DynamicResource AppTextBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-skip-previous-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle>
                </Button>
                <Button x:Name="PetPlayPauseBtn" Foreground="{DynamicResource AppAccentBrush}" Background="Transparent" BorderThickness="0" Click="PetPlayPauseBtn_Click" Cursor="Hand" Margin="0,0,4,0">
                    <Grid Width="14" Height="14">
                        <Rectangle x:Name="PetPlayIcon" Fill="{DynamicResource AppAccentBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-play-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle>
                        <TextBlock x:Name="PetPauseGlyph" Text="Ⅱ" Foreground="{DynamicResource AppAccentBrush}" FontSize="12" FontWeight="Bold" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Foreground="{DynamicResource AppTextBrush}" Background="Transparent" BorderThickness="0" Click="PetNextBtn_Click" Cursor="Hand" Margin="0,0,6,0">
                    <Rectangle Width="13" Height="13" Fill="{DynamicResource AppTextBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-skip-next-svgrepo-com.png"/></Rectangle.OpacityMask></Rectangle>
                </Button>
                <Rectangle Width="13" Height="13" Fill="{DynamicResource AppAccentBrush}" Margin="0,0,3,0">
                    <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-volume-loud-svgrepo-com.png"/></Rectangle.OpacityMask>
                </Rectangle>
                <Slider x:Name="PetVolumeSlider" Width="44" Minimum="0" Maximum="100" Value="80" ValueChanged="PetVolumeSlider_ValueChanged" VerticalAlignment="Center" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Pet Character Canvas -->
        <Grid x:Name="PetCharacterContainer"
              Width="140" Height="140"
              HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <!-- Main Sprite Graphic Group -->
            <Canvas Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="PetBodyTransform" Y="0"/>
                        <ScaleTransform x:Name="PetScaleTransform" ScaleX="1.0" ScaleY="1.0" CenterX="70" CenterY="70"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Shadow -->
                <Ellipse Canvas.Left="46" Canvas.Top="107" Width="48" Height="6" Fill="#26000000">
                    <Ellipse.Effect>
                        <BlurEffect Radius="2"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="56" Canvas.Top="108" Width="28" Height="3" Fill="#42000000"/>

                <Canvas x:Name="PetListeningStage"
                        Width="140" Height="140"
                        RenderTransformOrigin="0.5,0.78">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MusicGrooveScaleTransform"
                                             ScaleX="1" ScaleY="1"
                                             CenterX="70" CenterY="108"/>
                            <RotateTransform x:Name="MusicSwayTransform"/>
                            <TranslateTransform x:Name="MusicBounceTransform"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- 2D Pixel Art Sprite Image -->
                    <Image x:Name="PetSpriteImage"
                           Width="120" Height="120"
                           Canvas.Left="10" Canvas.Top="4"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           RenderOptions.EdgeMode="Aliased"/>
                </Canvas>

                <!-- Status Badge Indicator -->
                <Border x:Name="StatusBadge" Canvas.Left="95" Canvas.Top="15"
                        Background="#10B981" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                    <TextBlock x:Name="StatusBadgeText" Text="AI" Foreground="#0F172A" FontSize="9" FontWeight="Bold"/>
                </Border>
            </Canvas>

            <Canvas x:Name="MusicNotesCanvas"
                    Width="140" Height="140"
                    Panel.ZIndex="4"
                    IsHitTestVisible="False"
                    ClipToBounds="False"/>
        </Grid>
    </Grid>

    <Window.ContextMenu>
        <ContextMenu Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" BorderBrush="{DynamicResource AppTextBrush}" BorderThickness="2" Padding="2" FontFamily="Segoe UI" FontSize="12">
            <ContextMenu.Resources>
                <Style x:Key="PetMenuIcon" TargetType="{x:Type local:SvgIcon}">
                    <Setter Property="Width" Value="16"/>
                    <Setter Property="Height" Value="16"/>
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="UseLayoutRounding" Value="True"/>
                </Style>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                    <Setter Property="MinWidth" Value="220"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type MenuItem}">
                                <Grid>
                                    <Border x:Name="PixelCell" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                                        <Grid Height="29">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Icon"/>
                                            <ContentPresenter Grid.Column="1" Margin="4,0" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>
                                            <local:SvgIcon x:Name="MoreIndicator"
                                                           Grid.Column="2"
                                                           Style="{StaticResource PetMenuIcon}"
                                                           Source="/Resources/Icons/dot-menu-more-2-svgrepo-com.svg"
                                                           Width="13"
                                                           Height="13"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <Rectangle x:Name="PixelMarker"
                                               Width="3"
                                               Margin="0,1"
                                               HorizontalAlignment="Left"
                                               Fill="{DynamicResource AppAccentBrush}"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-2" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppTextBrush}" BorderThickness="2" Padding="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasItems" Value="True">
                                        <Setter TargetName="MoreIndicator" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="PixelCell" Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                                        <Setter TargetName="PixelCell" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                        <Setter TargetName="PixelMarker" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type Separator}">
                    <Setter Property="Height" Value="3"/>
                    <Setter Property="Margin" Value="7,4"/>
                    <Setter Property="Template">
                        <Setter.Value><ControlTemplate TargetType="{x:Type Separator}"><Border Background="{DynamicResource AppBorderBrush}" Height="1"/></ControlTemplate></Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>

            <!-- 1. STICKY NOTES SUBMENU -->
            <MenuItem Header="Sticky Notes">
                <MenuItem.Icon>
                    <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/note-sticky-svgrepo-com.svg"/>
                </MenuItem.Icon>
                <MenuItem Header="Add New Note" Click="MenuNewStickyNote_Click"/>
                <MenuItem Header="Show All Notes" Click="MenuShowAllStickyNotes_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/show-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Hide All Notes" Click="MenuHideAllStickyNotes_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/hide-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Manage Notes" Click="MenuManageStickyNotes_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/tool-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 2. DESKTOP FENCES SUBMENU -->
            <MenuItem Header="Desktop Fences">
                <MenuItem.Icon>
                    <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/fence.svg"/>
                </MenuItem.Icon>
                <MenuItem Header="New Shortcuts Fence" Click="MenuNewCustomFence_Click"/>
                <MenuItem Header="New Folder Portal..." Click="MenuNewFolderPortalFence_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/folder-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Toggle Fences Visibility" Click="MenuToggleFencesVisibility_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/show-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 2. MEDIA PLAYER SUBMENU -->
            <MenuItem Header="Music Player">
                <MenuItem.Icon>
                    <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/music-player-music-and-multimedia-svgrepo-com.svg"/>
                </MenuItem.Icon>
                <MenuItem Header="Open Music Player" Click="MenuMusicPlayer_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/music-note-slider-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MusicNotesToggleMenuItem" Header="Music Ambience: On" Click="MenuToggleMusicNotes_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/nature-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 3. TEXT TOOLS SUBMENU -->
            <MenuItem Header="Text Tools">
                <MenuItem.Icon>
                    <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/text-svgrepo-com.svg"/>
                </MenuItem.Icon>
                <MenuItem Header="Translate Selected Text" Click="MenuTranslate_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/translate-01-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="OCR Screen Snapper" Click="MenuOcr_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/scanner-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="De-gibberish Layout Fix" Click="MenuDeGibberish_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/convert-3d-cube-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 4. DESKTOP PET SUBMENU -->
            <MenuItem Header="Desktop Pet">
                <MenuItem.Icon>
                    <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/pet-svgrepo-com.svg"/>
                </MenuItem.Icon>
                <MenuItem Header="Talk to Character" Click="MenuAsk_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/chat-dots-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Switch Character">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/switch-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Pink Monster" Click="MenuCharPink_Click"/>
                    <MenuItem Header="Owlet Monster" Click="MenuCharOwlet_Click"/>
                    <MenuItem Header="Dude Monster" Click="MenuCharDude_Click"/>
                    <Separator/>
                    <MenuItem Header="Frieren" Click="MenuCharFrieren_Click"/>
                    <MenuItem Header="Yuji Itadori" Click="MenuCharYuji_Click"/>
                    <MenuItem Header="Monkey D. Luffy" Click="MenuCharLuffy_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Comments">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/chat-unread-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                    <MenuItem x:Name="CommentsToggleMenuItem" Header="Enable Comments: On" Click="MenuToggleComments_Click"/>
                    <MenuItem Header="Comment Frequency">
                        <MenuItem x:Name="CommentsQuietMenuItem" Header="Quiet (Rare)" Tag="Quiet" Click="MenuSetCommentFrequency_Click"/>
                        <MenuItem x:Name="CommentsNormalMenuItem" Header="Normal" Tag="Normal" Click="MenuSetCommentFrequency_Click"/>
                        <MenuItem x:Name="CommentsChattyMenuItem" Header="Chatty (Frequent)" Tag="Chatty" Click="MenuSetCommentFrequency_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="AiCommentsToggleMenuItem" Header="AI Ambient Comments: On" Click="MenuToggleAiComments_Click"/>
                </MenuItem>
                <MenuItem Header="Walking">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/walk-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                    <MenuItem x:Name="WalkingToggleMenuItem" Header="Enable Walking: On" Click="MenuToggleWalking_Click"/>
                    <MenuItem x:Name="HorizontalWalkingToggleMenuItem" Header="Horizontal Only: Off" Click="MenuToggleHorizontalWalking_Click"/>
                    <MenuItem Header="Movement Speed">
                        <MenuItem Header="Slow" Tag="45" Click="MenuSetWalkingSpeed_Click"/>
                        <MenuItem Header="Normal" Tag="92" Click="MenuSetWalkingSpeed_Click"/>
                        <MenuItem Header="Fast" Tag="160" Click="MenuSetWalkingSpeed_Click"/>
                    </MenuItem>
                    <MenuItem Header="Idle Animation Speed">
                        <MenuItem Header="Calm" Tag="750" Click="MenuSetIdleSpeed_Click"/>
                        <MenuItem Header="Normal" Tag="430" Click="MenuSetIdleSpeed_Click"/>
                        <MenuItem Header="Lively" Tag="220" Click="MenuSetIdleSpeed_Click"/>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Pet Settings" Click="MenuSettings_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/tool-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Hide Desktop Pet" Click="MenuHide_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/hide-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 5. KEYMAPPER SETTINGS SUBMENU -->
            <MenuItem Header="KeyMapper Settings">
                <MenuItem.Icon>
                    <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/setting-2-svgrepo-com.svg"/>
                </MenuItem.Icon>
                <MenuItem Header="Text Expansions &amp; Shortcuts" Click="MenuExpansions_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/shortcut-maker-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="All Settings" Click="MenuSettings_Click">
                    <MenuItem.Icon>
                        <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/tool-svgrepo-com.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <Separator/>

            <!-- 6. EXIT -->
            <MenuItem Header="Exit KeyMapper" Click="MenuExitApp_Click" Foreground="#B53D64">
                <MenuItem.Icon>
                    <local:SvgIcon Style="{StaticResource PetMenuIcon}" Source="/Resources/Icons/exit-svgrepo-com.svg"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
