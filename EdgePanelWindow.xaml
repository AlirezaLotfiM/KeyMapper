<Window x:Class="KeyMapper.EdgePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyMapper"
        Width="360" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing" Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="PanelBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F01A2840" Offset="0"/>
            <GradientStop Color="#EE10182D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Primary" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2563EB" Offset="0"/>
            <GradientStop Color="#FF22D3EE" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="#8FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22,0,0,22"/>
            <Setter Property="Padding" Value="12,13,3,13"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity=".6"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#38FFFFFF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B5BDEBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value=".7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="#DFFFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ModuleName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#AFC5E2"/>
            <Setter Property="Margin" Value="7,0,0,9"/>
        </Style>

        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="39"/>
            <Setter Property="Height" Value="39"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#45FFFFFF"/><Setter TargetName="Circle" Property="BorderBrush" Value="#C8DFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value=".68"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniActionButton" TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
        </Style>

        <Style x:Key="MiniHeaderIconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniGlassCircleButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="#65FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.76"/><Setter Property="Background" Value="#38FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniGlassPlayButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Cyber Progress Slider Style -->
        <Style x:Key="CyberNeonSlider" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#63F5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="#63F5FF" Height="3.5" CornerRadius="1.75"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="#25FFFFFF" Height="3.5" CornerRadius="1.75"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse Width="11" Height="11" Fill="#10182D" Stroke="#63F5FF" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ServerToolButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Margin" Value="4,4,2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#0DFFFFFF" CornerRadius="1"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#7FC7EDFF" CornerRadius="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type local:SmoothScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Margin="0,0,9,0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Style="{StaticResource ThinScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VPN Connecting Spinner & Icon Pulse Storyboard -->
        <Storyboard x:Key="VpnConnectingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="L1VpnSpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.1"/>
            <DoubleAnimation Storyboard.TargetName="L1VpnPowerScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.88" To="1.08" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="L1VpnPowerScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.88" To="1.08" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="L2VpnSpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.1"/>
        </Storyboard>

        <!-- VPN Connected Gentle Halo Pulse Storyboard -->
        <Storyboard x:Key="VpnConnectedGlowStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="L1VpnPowerOuterRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.9" Duration="0:0:1.6"/>
            <DoubleAnimation Storyboard.TargetName="L1VpnOuterScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1.12" Duration="0:0:1.6"/>
            <DoubleAnimation Storyboard.TargetName="L1VpnOuterScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.95" To="1.12" Duration="0:0:1.6"/>
        </Storyboard>
    </Window.Resources>

    <Grid Width="350" HorizontalAlignment="Right">
        <Border x:Name="Level1Panel" Width="228" Margin="0" HorizontalAlignment="Right" Visibility="Collapsed" Style="{StaticResource Panel}">
            <Border.RenderTransform><TranslateTransform x:Name="Level1SlideTransform"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="EDGE PANEL" FontSize="10" FontWeight="Bold" Foreground="#85DFF7"/>
                        <TextBlock Text="Quick actions" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <local:SmoothScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,6,0,0">
                    <StackPanel>
                        <!-- Mini Vertical Music Player -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Width="150" HorizontalAlignment="Center">
                                <!-- Top Bar: Icon, Title, Favorite & Expand buttons -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="12" Height="12" Source="/Resources/Icons/music-music-note-2-svgrepo-com.png" Margin="0,0,5,0"/>
                                        <TextBlock Text="MINI PLAYER" FontSize="10.5" FontWeight="Bold" Foreground="#85DFF7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="L1MusicLikeBtn" Content="♥" Foreground="#80FFFFFF" Style="{StaticResource MiniHeaderIconButton}" FontSize="13" Click="L1MusicLikeBtn_Click" Margin="0,0,4,0" ToolTip="Favorite track"/>
                                        <Button Style="{StaticResource MiniHeaderIconButton}" Click="ExpandMusicPlayer_Click" ToolTip="Open full music player">
                                            <Viewbox Width="11" Height="11">
                                                <Path Width="24" Height="24" Data="M2,9 L2,6.5 C2,4.01 4.01,2 6.5,2 L9,2 M15,2 L17.5,2 C19.99,2 22,4.01 22,6.5 L22,9 M22,16 L22,17.5 C22,19.99 19.99,22 17.5,22 L16,22 M9,22 L6.5,22 C4.01,22 2,19.99 2,17.5 L2,15" Stroke="#AFC5E2" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Album Cover Art (84x84) -->
                                <Border Width="84" Height="84" CornerRadius="10" Background="#38000000" HorizontalAlignment="Center" ClipToBounds="True" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="🎵" FontSize="26" Foreground="#E4B7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="L1MusicCoverImg" Width="84" Height="84" Stretch="UniformToFill" Visibility="Collapsed">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,84,84" RadiusX="10" RadiusY="10"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Track Details -->
                                <TextBlock x:Name="L1MusicTitleText" Text="No Track Playing" Foreground="#FFF8FAFC" FontSize="11" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                                <TextBlock x:Name="L1MusicArtistText" Text="Select a song" Foreground="#FFD8E1EC" FontSize="9.5" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                <!-- Controls -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Button Style="{StaticResource MiniGlassCircleButton}" Click="MusicPrev_Click" ToolTip="Previous track" Margin="0,0,8,0">
                                        <Rectangle Width="14" Height="14" Fill="#F8FAFC">
                                            <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-skip-previous-svgrepo-com.png"/></Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Button>
                                    <Button x:Name="L1MusicPlayPauseBtn" Style="{StaticResource MiniGlassPlayButton}" Click="MusicPlayPause_Click" ToolTip="Play / Pause">
                                        <Grid Width="16" Height="16">
                                            <Rectangle x:Name="L1MusicPlayIcon" Fill="White">
                                                <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-play-svgrepo-com.png"/></Rectangle.OpacityMask>
                                            </Rectangle>
                                            <TextBlock x:Name="L1MusicPauseGlyph" Text="Ⅱ" Foreground="White" FontSize="13" FontWeight="Bold" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource MiniGlassCircleButton}" Click="MusicNext_Click" ToolTip="Next track" Margin="8,0,0,0">
                                        <Rectangle Width="14" Height="14" Fill="#F8FAFC">
                                            <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-skip-next-svgrepo-com.png"/></Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Button>
                                </StackPanel>

                                <!-- Seekbar, readable time, and volume popup button -->
                                <Grid Width="135" Margin="0,0,0,2" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Slider Grid.Row="0" x:Name="L1MusicProgressSlider" Style="{StaticResource CyberNeonSlider}" Minimum="0" Maximum="100" Value="0" Cursor="Hand" ValueChanged="L1MusicProgressSlider_ValueChanged" PreviewMouseDown="L1MusicProgressSlider_PreviewMouseDown" PreviewMouseUp="L1MusicProgressSlider_PreviewMouseUp"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,3,24,0">
                                        <TextBlock x:Name="L1MusicElapsedText" Text="00:00" Foreground="#E6F4FF" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text=" / " Foreground="#AFC5E2" FontSize="9" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="L1MusicDurationText" Text="00:00" Foreground="#AFC5E2" FontSize="9" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button x:Name="L1MusicVolumeBtn" Grid.Row="1" HorizontalAlignment="Right" Width="22" Height="22" Padding="2" Style="{StaticResource MiniHeaderIconButton}" Click="L1MusicVolumeBtn_Click" ToolTip="Volume">
                                        <Rectangle Width="13" Height="13" Fill="#CDE6F7">
                                            <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Icons/music-volume-loud-svgrepo-com.png"/></Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- VPN Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="14" Height="14" Source="/Resources/Icons/cloud.png" Margin="0,0,5,0"/>
                                        <TextBlock Text="VPN" Style="{StaticResource ModuleName}" Foreground="#7CE7FF" Margin="0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#20000000" CornerRadius="8" Padding="6,2">
                                        <TextBlock x:Name="L1VpnStatusBadge" Text="OFF" FontSize="8.5" FontWeight="Bold" Foreground="#FB7185"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="L1VpnStatusText" Text="Disconnected" Foreground="White" FontWeight="SemiBold" FontSize="11" TextAlignment="Center"/>
                                <TextBlock x:Name="L1VpnServerName" Text="No server selected" Foreground="#AFC9DA" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="1.25*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource GlassButton}" Click="OpenVpnServersLevel2_Click" ToolTip="Browse VPN servers" Padding="6,7">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Width="18" Height="18" Source="/Resources/Icons/cloud.png" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Servers" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="VpnLevel1ToggleBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="VpnConnectToggle_Click" ToolTip="Connect / Disconnect" Padding="6,5">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                <!-- Outer Glow / Halo Ring -->
                                                <Ellipse x:Name="L1VpnPowerOuterRing" Stroke="#FB7185" StrokeThickness="1.5" Opacity=".5" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform x:Name="L1VpnOuterScale" ScaleX="1" ScaleY="1"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>

                                                <!-- Animated Spinning Orbit Ring (Active during Connecting) -->
                                                <Ellipse x:Name="L1VpnSpinnerRing" Stroke="#F59E0B" StrokeThickness="2" StrokeDashArray="2,2" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform x:Name="L1VpnSpinnerRotate" Angle="0"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>

                                                <!-- Inner Solid Ring -->
                                                <Ellipse x:Name="L1VpnPowerRing" Margin="4.5" Stroke="#FB7185" StrokeThickness="1.8"/>

                                                <!-- Inner Glass Disc -->
                                                <Border x:Name="L1VpnPowerDisc" Margin="8.5" Background="#18FFFFFF" CornerRadius="20"/>

                                                <!-- Centered Shutdown Power Icon with Scale & Glow -->
                                                <Grid x:Name="L1VpnIconContainer" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="L1VpnPowerScale" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>
                                                    <local:SvgIcon x:Name="L1VpnPowerIcon" Width="19" Height="19" Source="/Resources/Icons/shutdown.svg" Foreground="#FB7185" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <local:SvgIcon.Effect>
                                                            <DropShadowEffect x:Name="L1VpnPowerGlow" BlurRadius="8" ShadowDepth="0" Color="#FB7185" Opacity=".55"/>
                                                        </local:SvgIcon.Effect>
                                                    </local:SvgIcon>
                                                </Grid>

                                                <!-- Server Flag Badge (Floating bottom-right) -->
                                                <Border Width="18" Height="14" CornerRadius="4" Background="#D90F172A" BorderBrush="#55FFFFFF" BorderThickness="0.8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <TextBlock x:Name="L1VpnFlagText" Text="🌐" FontSize="8.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="VpnLevel1BtnText" Text="Connect" FontSize="9" FontWeight="SemiBold" Foreground="#E9FBFF" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Desktop Fences Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><local:SvgIcon Width="19" Height="19" Source="/Resources/Icons/fence.svg" Foreground="#FFB7C2"/><TextBlock Text="FENCES" Style="{StaticResource ModuleName}" Foreground="#FFB7C2" Margin="7,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MiniActionButton}" Click="CreateNewFence_Click" ToolTip="New shortcut fence">
                                        <Grid><local:SvgIcon Width="21" Height="21" Source="/Resources/Icons/fence.svg" Foreground="#FFD0D7"/><TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                                    </Button>
                                    <Button Style="{StaticResource MiniActionButton}" Click="CreatePortalFence_Click" ToolTip="New folder fence">
                                        <Grid><local:SvgIcon Width="21" Height="21" Source="/Resources/Icons/folder-svgrepo-com.svg" Foreground="#FFD0D7"/><TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sticky Notes Card -->
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><local:SvgIcon Width="19" Height="19" Source="/Resources/Icons/note-sticky-svgrepo-com.svg" Foreground="#97F4BF"/><TextBlock Text="STICKY NOTES" Style="{StaticResource ModuleName}" Foreground="#97F4BF" Margin="7,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MiniActionButton}" Click="CreateNewNote_Click" ToolTip="New note"><Grid><local:SvgIcon Width="20" Height="20" Source="/Resources/Icons/note-sticky-svgrepo-com.svg" Foreground="#A7FFD0"/><TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Button>
                                    <Button Style="{StaticResource MiniActionButton}" Click="ShowAllNotes_Click" ToolTip="Show all notes"><local:SvgIcon Width="20" Height="20" Source="/Resources/Icons/show-svgrepo-com.svg" Foreground="#A7FFD0"/></Button>
                                    <Button Style="{StaticResource MiniActionButton}" Click="HideAllNotes_Click" ToolTip="Hide all notes"><local:SvgIcon Width="20" Height="20" Source="/Resources/Icons/hide-svgrepo-com.svg" Foreground="#A7FFD0"/></Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </local:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- Level 2 Panel: VPN Servers -->
        <Border x:Name="Level2Panel" Width="340" Margin="0" HorizontalAlignment="Right" Visibility="Collapsed" Style="{StaticResource Panel}">
            <Border.RenderTransform><TranslateTransform x:Name="Level2SlideTransform"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource MiniActionButton}" Click="BackToLevel1_Click" ToolTip="Back">
                        <local:SvgIcon Width="17" Height="17" Source="/Resources/Icons/left.svg" Foreground="#DCE8F5"/>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0">
                        <TextBlock Text="VPN servers" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Select a server, then connect." FontSize="9.5" Foreground="#AFC5E2" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <local:SmoothScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,8,0,0">
                    <StackPanel>
                        <Border CornerRadius="19" Padding="12" Margin="0,0,0,13" BorderBrush="#67BCEEFF" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4A2563EB" Offset="0"/>
                                    <GradientStop Color="#2538BDF8" Offset=".5"/>
                                    <GradientStop Color="#181A2840" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Ellipse Width="130" Height="130" Fill="#1642E8FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-68,-54,0"/>
                                <StackPanel>
                                    <TextBlock Text="ACTIVE ROUTE" FontSize="9" FontWeight="Bold" Foreground="#B8EFFF"/>
                                    <TextBlock x:Name="L2SelectedServerText" Text="No server selected" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="L2HeroTrafficText" Text="Live traffic will appear here" Foreground="#CDE6F7" FontSize="9.5"/>
                                    <Button x:Name="VpnLevel2ToggleBtn" Style="{StaticResource PrimaryButton}" Click="VpnConnectToggle_Click" Margin="0,11,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse x:Name="L2VpnSpinnerRing" Stroke="#F59E0B" StrokeThickness="1.5" StrokeDashArray="2,2" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform x:Name="L2VpnSpinnerRotate" Angle="0"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <local:SvgIcon x:Name="L2VpnPowerIcon" Width="14" Height="14" Source="/Resources/Icons/shutdown.svg" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="VpnLevel2BtnText" Text="Connect to selected server" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ServerToolButton}" Click="PingAll_Click">
                                <StackPanel><Image Width="19" Height="19" Source="/Resources/Icons/speed.png" HorizontalAlignment="Center"/><TextBlock x:Name="SpeedTestBtnText" Text="Latency test" Foreground="#FFE69A" Margin="0,5,0,0" TextAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ServerToolButton}" Click="UpdateSubs_Click">
                                <StackPanel><local:SvgIcon Width="19" Height="19" Source="/Resources/Icons/rotate-left-1-svgrepo-com.svg" Foreground="#8CEBFF" HorizontalAlignment="Center"/><TextBlock x:Name="UpdateSubsBtnText" Text="Refresh routes" Foreground="#8CEBFF" Margin="0,5,0,0" TextAlignment="Center"/></StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,8" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="LIVE TRAFFIC" Style="{StaticResource ModuleName}"/>
                                <TextBlock x:Name="L2TrafficText" Text="Upload 0 B/s · Download 0 B/s" Foreground="White" FontSize="10" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="AVAILABLE ROUTES" Style="{StaticResource ModuleName}" FontSize="13"/>
                        <TextBlock Text="Click a route to select it" FontSize="9.5" Foreground="#9DB2CB" Margin="7,-4,0,6"/>
                        <ItemsControl x:Name="ServersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#17FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="13" Padding="10" Margin="0,5" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="ServerRow_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#35FFFFFF"/><Setter Property="BorderBrush" Value="#A4BDF0FF"/></Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#303B82F6"/><Setter Property="BorderBrush" Value="#D165DFFF"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="9" Background="#2638BDF8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CountryCodeDisplay}" Foreground="#A5F3FC" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="2,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CleanName}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AddressDisplay}" Foreground="#AFC5E2" FontSize="8.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ProtocolBadge}" Foreground="#D8B4FE" FontSize="7.5" FontWeight="Bold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{Binding PingBackgroundBrush}" CornerRadius="7" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PingDisplay}" Foreground="{Binding PingColorBrush}" FontSize="8" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </local:SmoothScrollViewer>
            </Grid>
        </Border>

        <!-- Volume popup attached to L1MusicVolumeBtn -->
        <Popup x:Name="MiniVolumePopup"
               PlacementTarget="{Binding ElementName=L1MusicVolumeBtn}"
               Placement="Left"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-6">
            <local:FlexVolumeControl x:Name="MiniFlexVolume"
                                     Width="46"
                                     Height="126"
                                     ValueChanged="MiniFlexVolume_ValueChanged"/>
        </Popup>

        <Button x:Name="EdgeHandle"
                Width="22" Height="174" HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Cursor="Hand"
                PreviewMouseLeftButtonDown="EdgeHandle_PreviewMouseLeftButtonDown"
                PreviewMouseMove="EdgeHandle_PreviewMouseMove"
                PreviewMouseLeftButtonUp="EdgeHandle_PreviewMouseLeftButtonUp"
                ToolTip="Click to open · Drag to reposition">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <!-- Wide transparent hit target; the visible glass strip stays intentionally slim. -->
                    <Border x:Name="Handle" Width="5" HorizontalAlignment="Right" Background="#12FFFFFF" BorderBrush="#75FFFFFF" BorderThickness="1,1,0,1" CornerRadius="3,0,0,3">
                        <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#BFEFFF" Opacity=".35"/></Border.Effect>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#35FFFFFF"/><Setter TargetName="Handle" Property="BorderBrush" Value="#DFFFFFFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Handle" Property="Background" Value="#55FFFFFF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
